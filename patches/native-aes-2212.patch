+// UniXNU QEMU: kernel-side SystemOS cache mount and launchd environment.
+extern "C" {
+typedef unsigned long long uxnu_addr;
+struct uxnu_mount_args { uxnu_addr type; uxnu_addr path; int flags; int pad; uxnu_addr data; };
+struct uxnu_exec_args { uxnu_addr fname; uxnu_addr argp; uxnu_addr envp; };
+extern int mount(void *, struct uxnu_mount_args *, int *);
+extern int execve(void *, struct uxnu_exec_args *, int *);
+volatile uxnu_addr uxnu_cache_scratch = 0;
+volatile int uxnu_cache_mounted = 0;
+volatile int unixnu_cache_mount_result = -1;
+static const char uxnu_cache_env[] = "DYLD_SHARED_CACHE_DIR=/cache/System/Library/Caches/com.apple.dyld";
+
+static __attribute__((noinline)) int uxcopy(const void *k, uxnu_addr u, unsigned long n) { return copyout(k, u, n); }
+
+int unixnu_mount_stub(void *p, uxnu_addr scratch, const char *path)
+{
+    if (!uxnu_cache_mounted) {
+        unsigned char data[0x150];
+        uxnu_cache_mounted = 1;
+        memset(data, 0, sizeof(data));
+        uxcopy("apfs", scratch + 0x00, 5);
+        uxcopy("/cache", scratch + 0x20, 7);
+        *(uxnu_addr *)(data + 0x00) = scratch + 0x40;
+        *(uxnu_addr *)(data + 0x08) = 1;
+        *(unsigned short *)(data + 0x10) = 1;
+        *(unsigned int *)(data + 0x144) = 99;
+        *(unsigned int *)(data + 0x148) = 99;
+        uxcopy(data, scratch + 0x80, sizeof(data));
+        struct uxnu_mount_args uap;
+        uap.type = scratch + 0x00;
+        uap.path = scratch + 0x20;
+        uap.flags = 1;
+        uap.pad = 0;
+        uap.data = scratch + 0x80;
+        int retval = 0;
+        int mr = -1;
+        static const char *const devs[] = { "/dev/disk0s1", "/dev/disk1s1", "/dev/disk2s1", "/dev/disk3s1" };
+        for (int i = 0; i < 4; i++) {
+            uxcopy(devs[i], scratch + 0x40, 14);
+            uxcopy(data, scratch + 0x80, sizeof(data));
+            mr = mount(p, &uap, &retval);
+            if (!mr) break;
+        }
+        uxcopy(uxnu_cache_env, scratch + 0xF00, sizeof(uxnu_cache_env));
+        uxnu_addr envp[2] = { scratch + 0xF00, 0 };
+        uxcopy(envp, scratch + 0xF80, sizeof(envp));
+        unixnu_cache_mount_result = mr;
+    }
+    uxnu_cache_scratch = scratch;
+    return ((int (*)(void *, uxnu_addr, const char *))0xfffffff0076d6ff4ULL)(p, scratch, path);
+}
+
+int unixnu_exec_stub(void *p, struct uxnu_exec_args *uap, int *retval)
+{
+    if (uxnu_cache_scratch) uap->envp = uxnu_cache_scratch + 0xF80;
+    return execve(p, uap, retval);
+}
