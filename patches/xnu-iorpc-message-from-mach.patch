+/* UniXNU compatibility: some iOS 16 kernelcache components reference the
+ * user-facing IORPCMessageFromMach symbol when prelinked into the kernel. */
+extern "C" __attribute__((used, retain, visibility("default"))) IORPCMessage *
+IORPCMessageFromMach(IORPCMessageMach * msg, bool reply)
+{
+	if (!reply) {
+		return nullptr;
+	}
+	return IORPCMessageFromMachReply(msg);
