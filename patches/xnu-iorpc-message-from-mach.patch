diff --git a/iokit/Kernel/IOUserServer.cpp b/iokit/Kernel/IOUserServer.cpp
--- a/iokit/Kernel/IOUserServer.cpp
+++ b/iokit/Kernel/IOUserServer.cpp
@@ -3668,3 +3668,14 @@ IORPCMessageFromMachReply(IORPCMessageMach * msg)
 	return (IORPCMessage *)msg;
 }
+
+/* UniXNU compatibility: some iOS 16 kernelcache components reference the
+ * user-facing IORPCMessageFromMach symbol when prelinked into the kernel. */
+extern "C" IORPCMessage *
+IORPCMessageFromMach(IORPCMessageMach * msg, bool reply)
+{
+	if (!reply) {
+		return nullptr;
+	}
+	return IORPCMessageFromMachReply(msg);
+}
