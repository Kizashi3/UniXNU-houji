@@ -7,9 +7,149 @@
 
 #include "Internal.h"
 
+#include <Guid/FileInfo.h>
+#include <Protocol/LoadedImage.h>
 #include <Protocol/SerialIo.h>
 
 STATIC EFI_SERIAL_IO_PROTOCOL  *mSerial;
+STATIC EFI_FILE_PROTOCOL       *mLogFile;
+
+STATIC
+EFI_STATUS
+OpenLogDirectory (
+  IN EFI_FILE_PROTOCOL  *Root,
+  IN CONST CHAR16       *Path
+  )
+{
+  EFI_FILE_PROTOCOL  *Directory;
+  EFI_STATUS          Status;
+
+  Status = Root->Open (
+    Root,
+    &Directory,
+    (CHAR16 *)Path,
+    EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE | EFI_FILE_MODE_CREATE,
+    EFI_FILE_DIRECTORY
+    );
+  if (!EFI_ERROR (Status) && (Directory != NULL)) {
+    Directory->Close (Directory);
+  }
+  return Status;
+}
+
+STATIC
+EFI_STATUS
+OpenLogOnVolume (
+  IN  EFI_HANDLE         Volume,
+  OUT EFI_FILE_PROTOCOL  **File
+  )
+{
+  EFI_SIMPLE_FILE_SYSTEM_PROTOCOL  *Fs;
+  EFI_FILE_PROTOCOL                *Root;
+  EFI_FILE_PROTOCOL                *Opened;
+  EFI_FILE_INFO                    *Info;
+  EFI_STATUS                       Status;
+  UINTN                            InfoSize;
+
+  *File = NULL;
+  Status = gBS->HandleProtocol (Volume, &gEfiSimpleFileSystemProtocolGuid, (VOID **)&Fs);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+  Status = Fs->OpenVolume (Fs, &Root);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = OpenLogDirectory (Root, L"\\EFI");
+  if (!EFI_ERROR (Status)) {
+    Status = OpenLogDirectory (Root, L"\\EFI\\UniXNU");
+  }
+  if (!EFI_ERROR (Status)) {
+    Status = OpenLogDirectory (Root, L"\\EFI\\UniXNU\\logs");
+  }
+  if (EFI_ERROR (Status)) {
+    Root->Close (Root);
+    return Status;
+  }
+
+  Status = Root->Open (
+    Root,
+    &Opened,
+    L"\\EFI\\UniXNU\\logs\\boot.log",
+    EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE | EFI_FILE_MODE_CREATE,
+    0
+    );
+  Root->Close (Root);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  // Start a fresh record for each boot while retaining the file itself.
+  InfoSize = 0;
+  Status = Opened->GetInfo (Opened, &gEfiFileInfoGuid, &InfoSize, NULL);
+  if (Status == EFI_BUFFER_TOO_SMALL) {
+    Info = AllocateZeroPool (InfoSize);
+    if (Info != NULL) {
+      if (!EFI_ERROR (Opened->GetInfo (Opened, &gEfiFileInfoGuid, &InfoSize, Info))) {
+        Info->FileSize = 0;
+        Opened->SetInfo (Opened, &gEfiFileInfoGuid, InfoSize, Info);
+      }
+      FreePool (Info);
+    }
+  }
+  Opened->SetPosition (Opened, 0);
+  *File = Opened;
+  return EFI_SUCCESS;
+}
+
+STATIC
+VOID
+InitLogFile (
+  IN EFI_HANDLE  ImageHandle
+  )
+{
+  EFI_LOADED_IMAGE_PROTOCOL  *Loaded;
+  EFI_HANDLE                 Volume;
+  EFI_STATUS                 Status;
+
+  mLogFile = NULL;
+  Status = gBS->HandleProtocol (ImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&Loaded);
+  if (EFI_ERROR (Status) || (Loaded == NULL)) {
+    return;
+  }
+  Volume = Loaded->DeviceHandle;
+  if (Volume != NULL && !EFI_ERROR (OpenLogOnVolume (Volume, &mLogFile))) {
+    return;
+  }
+
+  // A firmware-volume copy of UniXNU may have no SimpleFileSystem device
+  // handle. Try every exposed FAT filesystem as a recovery-visible fallback.
+  {
+    EFI_HANDLE  *Handles;
+    UINTN       Count;
+    UINTN       Index;
+
+    Handles = NULL;
+    Count   = 0;
+    if (!EFI_ERROR (gBS->LocateHandleBuffer (
+                      ByProtocol,
+                      &gEfiSimpleFileSystemProtocolGuid,
+                      NULL,
+                      &Count,
+                      &Handles
+                      ))) {
+      for (Index = 0; Index < Count; Index++) {
+        if (!EFI_ERROR (OpenLogOnVolume (Handles[Index], &mLogFile))) {
+          break;
+        }
+      }
+      if (Handles != NULL) {
+        FreePool (Handles);
+      }
+    }
+  }
+}
 
