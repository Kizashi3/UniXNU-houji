+STATIC
+VOID
+FillRect (
+  IN UNIXNU_UI                          *Ui,
+  IN UINTN                          X,
+  IN UINTN                          Y,
+  IN UINTN                          W,
+  IN UINTN                          H,
+  IN EFI_GRAPHICS_OUTPUT_BLT_PIXEL  Color
+  );
+
+STATIC
+VOID
+DrawQrMarker (
+  IN UNIXNU_UI  *Ui
+  )
+{
+  UINTN  Module;
+  UINTN  Quiet;
+  UINTN  Size;
+  UINTN  X;
+  UINTN  Y;
+  UINTN  Row;
+  UINTN  Col;
+
+  if (Ui->Mode != UniXNUUiGraphics || Ui->Gop == NULL) {
+    return;
+  }
+  Module = MAX (2, MIN (Ui->Scale, 5));
+  Quiet  = 4 * Module;
+  Size   = (UNIXNU_QR_SIZE * Module) + (2 * Quiet);
+  if ((Size >= Ui->Width) || (Size >= Ui->Height)) {
+    return;
+  }
+  X = Ui->Width - Size - Module;
+  Y = Ui->Height - Size - Module;
+  FillRect (Ui, X, Y, Size, Size, mText);
+  for (Row = 0; Row < UNIXNU_QR_SIZE; Row++) {
+    for (Col = 0; Col < UNIXNU_QR_SIZE; Col++) {
+      if ((gUniXNUQrMarker[Row] & (1U << Col)) != 0) {
+        FillRect (Ui, X + Quiet + Col * Module, Y + Quiet + Row * Module,
+                  Module, Module, mBackground);
+      }
+    }
+  }
+}
