diff --git a/bsd/kern/kern_priv.c b/bsd/kern/kern_priv.c
index 88adf2d..0592d3d 100644
--- a/bsd/kern/kern_priv.c
+++ b/bsd/kern/kern_priv.c
@@ -77,6 +77,76 @@ int proc_check_footprint_priv(void);
 int
 priv_check_cred(kauth_cred_t cred, int priv, int flags)
 {
+	/*
+	 * HOUJI-PRIV: without a Sandbox kext nothing grants PRIV_WORK_INTERVAL, so
+	 * CoreAnimation's work_interval_create(CA_CLIENT) fails in SpringBoard and the
+	 * renderer never starts.  Grant that one privilege to every credential.
+	 */
+	if (priv == PRIV_WORK_INTERVAL) {
+		return 0;
+	}
+
+#include <security/mac_policy.h>
+#include <security/mac_internal.h>
+
+/*
+ * HOUJI-SANDBOX: libsystem_sandbox issues __mac_syscall("Sandbox", op, arg).  With no
+ * policy of that name every call fails with ENOPOLICY and launchd reports mach lookups
+ * as "error = 159: Sandbox restriction", which is what keeps backboardd away from
+ * mobilegestalt and iohideventsystem.  This stand-in allows the operations; only the
+ * ones that must return a path or a token answer ENOENT.
+ */
+static uint64_t houji_sandbox_seen;
+
+static int
+houji_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	(void) arg;
+	if (call >= 0 && call < 64 && !(houji_sandbox_seen & (1ULL << call))) {
+		char name[32];
+
+		houji_sandbox_seen |= 1ULL << call;
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("HOUJI-SANDBOX: %s op %d\n", name, call);
+	}
+	switch (call) {
+	case 4:    /* container path */
+	case 5:    /* extension issue */
+	case 6:    /* extension consume */
+	case 0x43: /* container expected */
+		return ENOENT;
+	default:
+		return 0;
+	}
+}
+
+static struct mac_policy_ops houji_sandbox_ops = {
+	.mpo_policy_syscall = houji_sandbox_syscall,
+};
+
+static struct mac_policy_conf houji_sandbox_conf = {
+	.mpc_name = "Sandbox",
+	.mpc_fullname = "HOUJI permissive sandbox stand-in",
+	.mpc_ops = &houji_sandbox_ops,
+};
+
+static mac_policy_handle_t houji_sandbox_handle;
+static int houji_sandbox_done;
+
+int
+houji_sandbox_policy_register(void)
+{
+	int error;
+
+	if (houji_sandbox_done) {
+		return 0;
+	}
+	houji_sandbox_done = 1;
+	error = mac_policy_register(&houji_sandbox_conf, &houji_sandbox_handle, NULL);
+	printf("HOUJI-SANDBOX: policy %s (%d)\n", error ? "NOT registered" : "registered", error);
+	return error;
+}
+
 #if !CONFIG_MACF
 #pragma unused(priv)
 #endif
