diff --git a/iokit/Kernel/IOService.cpp b/iokit/Kernel/IOService.cpp
--- a/iokit/Kernel/IOService.cpp
+++ b/iokit/Kernel/IOService.cpp
@@ -6734,10 +6734,74 @@
 }
 
 
+static unsigned long houji_sm_hits;
+
+extern "C" unsigned long
+houji_sm_cache_hits(void)
+{
+	return houji_sm_hits;
+}
+
+static bool
+houji_name_is(const char *n, const char *want)
+{
+	if (!n) {
+		return false;
+	}
+	while (*want && *n == *want) {
+		n++;
+		want++;
+	}
+	return *want == 0 && *n == 0;
+}
+
 OSDictionary *
 IOService::serviceMatching( const char * name,
     OSDictionary * table )
 {
+	/*
+	 * HOUJI-AMFI-MATCH: AMFI polls for services this platform does not
+	 * publish (IODTNVRAM, AppleSEPManager); every call allocated a matching
+	 * dictionary that was never released and exhausted the OSDictionary zone.
+	 * Reuse one cached dictionary per class name, and throttle the cached
+	 * path: the poll loop goes through here on every iteration, so a small
+	 * sleep caps it even when the wait itself returns at once.
+	 */
+	static OSDictionary *houji_match_cache[2];
+	bool houji_is_nvram = houji_name_is (name, "IODTNVRAM");
+	bool houji_is_sep   = houji_name_is (name, "AppleSEPManager");
+	int  houji_slot     = houji_is_nvram ? 0 : (houji_is_sep ? 1 : -1);
+
+	if (houji_slot >= 0 && houji_match_cache[houji_slot] != nullptr) {
+		houji_sm_hits++;
+		IOSleep(100);
+		houji_match_cache[houji_slot]->retain ();
+		return houji_match_cache[houji_slot];
+	}
+
+	{
+		static int houji_sm_logged;
+		static unsigned long houji_sm_count;
+		houji_sm_count++;
+		if (houji_sm_logged < 8 ||
+		    (houji_sm_count % 200000UL) == 0) {
+			unsigned long ra = (unsigned long)__builtin_return_address(0);
+			static const char hx[] = "0123456789abcdef";
+			char dbuf[50];
+			for (int i = 0; i < 16; i++) {
+				dbuf[i * 3] = hx[(ra >> (60 - i * 4)) & 0xf];
+				dbuf[i * 3 + 1] = ' ';
+				dbuf[i * 3 + 2] = ' ';
+			}
+			dbuf[48] = 0;
+			if (houji_sm_logged < 8) {
+				houji_sm_logged++;
+			}
+			printf("HOUJI-SM[%lu]: %s name=%s\n", houji_sm_count, dbuf,
+			    name ? name : "-");
+		}
+	}
+
 	const OSString *    str;
 
 	str = OSSymbol::withCString( name );
@@ -6747,6 +6811,10 @@
 
 	table = serviceMatching( str, table );
 	str->release();
+	if (houji_slot >= 0 && houji_match_cache[houji_slot] == nullptr && table) {
+		houji_match_cache[houji_slot] = table;
+		table->retain ();
+	}
 	return table;
 }
 
