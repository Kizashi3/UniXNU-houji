diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 92142f7..c8be058 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -54,6 +54,36 @@ extern "C" {
 #include <corecrypto/ccsha2.h>
 #include <kdp/sk_core.h>
 
+/*
+ * UniXNU: an in-place boot ramdisk can sit outside the physical aperture the
+ * bootloader handed the kernel, so the static map cannot name it and the range
+ * has to be mapped explicitly.  iokit/ is never compiled with
+ * MACH_KERNEL_PRIVATE, therefore <vm/pmap.h> does not expose pmap_map() and
+ * <mach/arm/vm_param.h> does not expose gPhysBase/gPhysSize even though both
+ * exist in the kernel image.  These declarations are inside the extern "C"
+ * include block above, so they pick up C linkage and match those symbols.
+ */
+#include <vm/vm_kern.h>
+#if defined(__has_include)
+# if __has_include(<vm/memory_types.h>)
+#  include <vm/memory_types.h>
+# endif
+#endif
+#ifndef VM_WIMG_DEFAULT
+#define VM_WIMG_DEFAULT 0x2 /* VM_MEM_COHERENT: normal cacheable memory */
+#endif
+
+#if defined(__arm64__)
+extern vm_map_address_t pmap_map(vm_map_address_t va, vm_offset_t sa, vm_offset_t ea,
+    vm_prot_t prot, unsigned int flags);
+extern unsigned long gPhysBase, gPhysSize;
+extern "C" boolean_t native_ufs_fill_ramdisk(vm_offset_t base, vm_size_t size);
+extern "C" boolean_t native_ufs_fill2(vm_offset_t base, vm_size_t size);
+extern "C" int native_ufs_md_init(void);
+extern "C" uint64_t native_ufs_md_window_bytes(const char *name);
+extern "C" int mdevadd_ufs(int devid, const char *name, uint64_t bytes);
+#endif /* __arm64__ */
+
 // how long to wait for matching root device, secs
 #if DEBUG
 #define ROOTDEVICETIMEOUT       120
@@ -773,7 +803,90 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 					panic("ramdisk params");
 				}
 #endif /* __LP64__ */
-				(void)mdevadd(-1, ml_static_ptovirt(ramdParms[0]) >> 12, (unsigned int) (ramdParms[1] >> 12), 0);        /* Initialize it and pass back the device number */
+				#if defined(__arm64__)
+					/*
+					 * UniXNU: mdevadd() is fed a software-page shifted kernel virtual address, and
+					 * ml_static_ptovirt() can only name memory inside the aperture the kernel owns.
+					 * When the bootloader leaves the ramdisk outside that window (in-place boot), map
+					 * the physical range explicitly instead of guessing an address through the static
+					 * map.  Boot allocations are only guaranteed to be hardware-page aligned, so grow
+					 * the mapping down to a software page and hand mdev the shifted base.
+					 */
+					vm_offset_t ramdBase = 0;
+					boolean_t mdFromWindows = FALSE;
+					char ufsmdSpec[32];
+					/*
+					 * HOUJI-UFS-MD: with ufs-md=1 the md devices read straight from the userdata windows
+					 * named in the manifest, so no container has to be resident.  The device size equals
+					 * the window, which is what nx_dev_init checks before it will mount a container.
+					 */
+					if (PE_parse_boot_argn("ufs-md", ufsmdSpec, sizeof(ufsmdSpec)) &&
+						native_ufs_md_init() == 0) {
+						uint64_t mdOS = native_ufs_md_window_bytes("OS");
+						uint64_t mdSys = native_ufs_md_window_bytes("SystemOS");
+						if (!mdOS) {
+							panic("ufs-md: no OS window in the root manifest");
+						}
+						if (mdevadd_ufs(0, "OS", mdOS) < 0) {
+							panic("ufs-md: md0 window device failed");
+						}
+						if (mdSys && mdevadd_ufs(1, "SystemOS", mdSys) < 0) {
+							panic("ufs-md: md1 window device failed");
+						}
+						IOLog("HOUJI-UFS-MD: md0=%#llx md1=%#llx\n", (uint64_t)mdOS, (uint64_t)mdSys);
+					mdFromWindows = TRUE;
+					} else if ((ramdParms[0] >= gPhysBase) && ((ramdParms[0] - gPhysBase) < gPhysSize) &&
+					    (ramdParms[1] <= (gPhysSize - (ramdParms[0] - gPhysBase)))) {
+						ramdBase = ml_static_ptovirt(ramdParms[0]);
+					} else {
+						vm_offset_t ramdPhys = (vm_offset_t)ramdParms[0];
+						vm_size_t ramdOffset = (vm_size_t)(ramdPhys & PAGE_MASK);
+						vm_size_t ramdSpan = round_page((vm_size_t)ramdParms[1] + ramdOffset);
+						vm_offset_t ramdMap;
+						/* HOUJI-VAONLY: only address space here; pmap_map below installs the
+						 * ramdisk PTEs. A real kmem_alloc would wire RAM equal to the volume
+						 * (2.8GB) and starve the kernel (kmem_alloc failed with 6 on device). */
+						IOLog("HOUJI-RAMD-MAP: vaonly=1 phys=%#llx span=%#llx\n", (uint64_t)ramdPhys, (uint64_t)ramdSpan);
+						kern_return_t kr = kernel_memory_allocate(kernel_map, &ramdMap, ramdSpan, 0,
+						    static_cast<kma_flags_t>(KMA_NOFAIL | KMA_PERMANENT | KMA_VAONLY),
+						    VM_KERN_MEMORY_IOKIT);
+						if (kr != KERN_SUCCESS) {
+							panic("ramdisk map failed %llx+%llx",
+							    (uint64_t)ramdParms[0], (uint64_t)ramdParms[1]);
+						}
+						pmap_map(ramdMap, ramdPhys - ramdOffset, ramdPhys - ramdOffset + ramdSpan,
+						    VM_PROT_READ | VM_PROT_WRITE, VM_WIMG_DEFAULT);
+						ramdBase = ramdMap + ramdOffset;
+					}
+					if (!mdFromWindows && !native_ufs_fill_ramdisk(ramdBase, (vm_size_t)ramdParms[1])) {
+						panic("native-ufs: ramdisk fill failed");
+					}
+					if (!mdFromWindows) {
+						(void)mdevadd(-1, ramdBase >> 12, (unsigned int) (ramdParms[1] >> 12), 0);        /* Initialize it and pass back the device number */
+					}
+					if (!mdFromWindows) {
+						char rd2Spec[64];
+						if (PE_parse_boot_argn("rd2", rd2Spec, sizeof(rd2Spec))) {
+							uint64_t rd2Paddr = 0, rd2Size = 0;
+							const char *rp = rd2Spec;
+							if (rp[0] == '0' && (rp[1] == 'x' || rp[1] == 'X')) rp += 2;
+							while ((*rp >= '0' && *rp <= '9') || (*rp >= 'a' && *rp <= 'f') || (*rp >= 'A' && *rp <= 'F')) { char rc = *rp++; rd2Paddr <<= 4; rd2Paddr |= (rc >= '0' && rc <= '9') ? (uint64_t)(rc - '0') : (uint64_t)((rc | 0x20) - 'a' + 10); }
+							if (*rp == ':') {
+								rp++;
+								if (rp[0] == '0' && (rp[1] == 'x' || rp[1] == 'X')) rp += 2;
+								while ((*rp >= '0' && *rp <= '9') || (*rp >= 'a' && *rp <= 'f') || (*rp >= 'A' && *rp <= 'F')) { char rc = *rp++; rd2Size <<= 4; rd2Size |= (rc >= '0' && rc <= '9') ? (uint64_t)(rc - '0') : (uint64_t)((rc | 0x20) - 'a' + 10); }
+							}
+							if (rd2Paddr && rd2Size) {
+								vm_offset_t rd2Base = ml_static_ptovirt(rd2Paddr);
+								if (!native_ufs_fill2(rd2Base, (vm_size_t)rd2Size)) panic("native-ufs: fill2 failed");
+								(void)mdevadd(-1, rd2Base >> 12, (unsigned int)(rd2Size >> 12), 0);
+								IOLog("HOUJI-RD2: md1 base=%#lx size=%#llx\n", (unsigned long)rd2Base, (unsigned long long)rd2Size);
+							}
+						}
+					}
+				#else
+					(void)mdevadd(-1, ml_static_ptovirt(ramdParms[0]) >> 12, (unsigned int) (ramdParms[1] >> 12), 0);        /* Initialize it and pass back the device number */
+				#endif /* __arm64__ */
 			}
 			regEntry->release();                                                            /* Toss the entry */
 		}
