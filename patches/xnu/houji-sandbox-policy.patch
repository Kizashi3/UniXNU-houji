diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index bb558ee..0e354b9 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -478,6 +478,60 @@ bsd_rooted_ramdisk(void)
  * of the tro_ucred field so that the uthread structure can be
  * used like any other.
  */
+#if CONFIG_MACF
+#include <security/mac_policy.h>
+
+static uint64_t houji_sandbox_seen;
+
+static int
+houji_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	(void) arg;
+	if (call >= 0 && call < 64 && !(houji_sandbox_seen & (1ULL << call))) {
+		char name[32];
+		houji_sandbox_seen |= 1ULL << call;
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("HOUJI-SANDBOX: %s op %d\n", name, call);
+	}
+	switch (call) {
+	case 4:   /* container path */
+	case 5:   /* extension issue */
+	case 6:   /* extension consume */
+	case 0x43: /* container expected */
+		return ENOENT;
+	default:
+		return 0;
+	}
+}
+
+static struct mac_policy_ops houji_sandbox_ops = {
+	.mpo_policy_syscall = houji_sandbox_syscall,
+};
+
+static struct mac_policy_conf houji_sandbox_conf = {
+	.mpc_name = "Sandbox",
+	.mpc_fullname = "HOUJI permissive sandbox stand-in",
+	.mpc_ops = &houji_sandbox_ops,
+};
+
+static mac_policy_handle_t houji_sandbox_handle;
+static int houji_sandbox_done;
+
+int
+houji_sandbox_policy_register(void)
+{
+	int error;
+
+	if (houji_sandbox_done) {
+		return 0;
+	}
+	houji_sandbox_done = 1;
+	error = mac_policy_register(&houji_sandbox_conf, &houji_sandbox_handle, NULL);
+	printf("HOUJI-SANDBOX: policy %s (%d)\n", error ? "NOT registered" : "registered", error);
+	return error;
+}
+#endif /* CONFIG_MACF */
+
 void
 bsd_init(void)
 {
@@ -572,10 +626,22 @@ bsd_init(void)
 	ut = current_uthread();
 
 #if CONFIG_MACF
+	/*
+	 * HOUJI-SANDBOX: register a permissive policy named "Sandbox" before launchd
+	 * starts.  libsystem_sandbox issues __mac_syscall("Sandbox", op, arg); without a
+	 * policy of that name every call fails with ENOPOLICY and launchd reports mach
+	 * lookups as "error = 159: Sandbox restriction" (backboardd cannot reach
+	 * mobilegestalt or iohideventsystem).  Operations that must return a path or a
+	 * token answer ENOENT; everything else succeeds.
+	 */
 	/*
 	 * Initialize the MAC Framework
 	 */
 	mac_policy_initbsd();
+	{
+		extern int houji_sandbox_policy_register(void);
+		(void) houji_sandbox_policy_register();
+	}
 
 #if defined (__i386__) || defined (__x86_64__)
