diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
index 8a1ec42..4799ed0 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -79,6 +79,94 @@ __XNU_PRIVATE_EXTERN    int             syscalls_log[SYS_MAXSYSCALL];
 extern int mach_trap_count;
 #endif
 
+struct houji_sys_rec { uint32_t code; int32_t error; uint64_t pc, lr, x0; };
+static struct houji_sys_rec houji_sys_ring[64];
+static unsigned houji_sys_ring_at;
+static int houji_sys_pid = -1;
+
+void houji_sys_dump(int pid);
+
+static int
+houji_is_springboard(const char *name)
+{
+	static const char want[] = "SpringBoard";
+	int i;
+
+	for (i = 0; want[i] != 0; i++) {
+		if (name[i] != want[i]) {
+			return 0;
+		}
+	}
+	return name[i] == 0;
+}
+
+static void
+houji_sys_record(unsigned code, int32_t error, uint64_t pc, uint64_t lr, uint64_t x0)
+{
+	struct houji_sys_rec *r = &houji_sys_ring[houji_sys_ring_at++ % 64];
+
+	r->code = (uint32_t)code;
+	r->error = error;
+	r->pc = pc;
+	r->lr = lr;
+	r->x0 = x0;
+}
+
+extern uint64_t mach_absolute_time(void);
+extern void absolutetime_to_nanoseconds(uint64_t, uint64_t *);
+
+/*
+ * Called from every unix syscall. If the sampled process stops calling, the
+ * ring stops changing; dump it once, 30 s after the stall, so a blocked launch
+ * is visible without waiting for the process to exit.
+ */
+static unsigned houji_sys_last_seen;
+static int houji_sys_stall_reported;
+static uint64_t houji_sys_next_tick;
+
+static void
+houji_sys_tick(void)
+{
+	uint64_t now = mach_absolute_time(), ns;
+
+	absolutetime_to_nanoseconds(now, &ns);
+	if (houji_sys_next_tick == 0) {
+		houji_sys_next_tick = ns + 30000000000ULL;
+		return;
+	}
+	if (ns < houji_sys_next_tick) {
+		return;
+	}
+	houji_sys_next_tick = ns + 30000000000ULL;
+	if (houji_sys_ring_at != houji_sys_last_seen) {
+		houji_sys_last_seen = houji_sys_ring_at;
+		houji_sys_stall_reported = 0;
+	} else if (!houji_sys_stall_reported && houji_sys_ring_at != 0) {
+		houji_sys_stall_reported = 1;
+		houji_sys_dump(houji_sys_pid);
+	}
+}
+
+/* Last calls and their errors for the sampled process, printed when it exits. */
+void
+houji_sys_dump(int pid)
+{
+	unsigned i;
+
+	if (pid != houji_sys_pid || houji_sys_ring_at == 0) {
+		return;
+	}
+	printf("HOUJI-SYSRING: last calls of pid %d\n", pid);
+	for (i = 0; i < 64; i++) {
+		struct houji_sys_rec *r = &houji_sys_ring[(houji_sys_ring_at + i) % 64];
+		if (r->code == 0) {
+			continue;
+		}
+		printf("HOUJI-SYSRING: code %u err %d pc=%#llx lr=%#llx x0=%#llx\n",
+		    r->code, r->error, r->pc, r->lr, r->x0);
+	}
+}
+
 /*
  * Function:	unix_syscall
  *
@@ -102,6 +190,43 @@ unix_syscall(
 
 	code = arm_get_syscall_number(state);
 
+	/* HOUJI-SYS: sample one process's syscall sites (boot arg houji-sys-pid). */
+	{
+		extern boolean_t PE_parse_boot_argn(const char *, void *, int);
+		static unsigned houji_sys_seen;
+		static unsigned houji_sys_count;
+		if (houji_sys_pid < 0) {
+			int v = 0;
+			PE_parse_boot_argn("houji-sys-pid", &v, sizeof(v));
+			houji_sys_pid = v;
+		}
+		if (houji_sys_pid == 0 && houji_is_springboard(proc->p_comm)) {
+			houji_sys_pid = proc_getpid(proc);
+			printf("HOUJI-SYS: attached to SpringBoard pid %d\n", houji_sys_pid);
+		}
+		if (houji_sys_pid > 0 && proc_getpid(proc) == houji_sys_pid &&
+		    is_saved_state64(state)) {
+			/* Record on entry with a sentinel error: a call that never
+			 * returns still becomes the newest ring entry. */
+			houji_sys_record((unsigned)code, -999,
+			    (uint64_t)saved_state64(state)->pc,
+			    (uint64_t)saved_state64(state)->lr,
+			    (uint64_t)saved_state64(state)->x[0]);
+			houji_sys_seen++;
+			if (houji_sys_seen <= 40 || (houji_sys_seen & 31) == 0) {
+				if (houji_sys_count < 400) {
+					houji_sys_count++;
+					printf("HOUJI-SYS: pid %d code %u pc=%#llx lr=%#llx x0=%#llx\n",
+					    houji_sys_pid, (unsigned)code,
+					    (unsigned long long)saved_state64(state)->pc,
+					    (unsigned long long)saved_state64(state)->lr,
+					    (unsigned long long)saved_state64(state)->x[0]);
+				}
+			}
+		}
+		houji_sys_tick();
+	}
+
 #define unix_syscall_kprintf(x...)      /* kprintf("unix_syscall: " x) */
 
 	if (kdebug_enable && !code_is_kdebug_trace(code)) {
@@ -180,6 +305,77 @@ unix_syscall(
 	AUDIT_SYSCALL_ENTER(code, proc, uthread);
 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
+	/* HOUJI-SYSX: the first calls with the error each one returned. */
+	if (houji_sys_pid > 0 && pid == houji_sys_pid && is_saved_state64(state)) {
+		static unsigned houji_sys_xcount;
+		if (houji_sys_xcount < 200) {
+			houji_sys_xcount++;
+			printf("HOUJI-SYSX: code %u err %d pc=%#llx lr=%#llx x0=%#llx\n",
+			    (unsigned)code, error,
+			    (unsigned long long)saved_state64(state)->pc,
+			    (unsigned long long)saved_state64(state)->lr,
+			    (unsigned long long)saved_state64(state)->x[0]);
+		}
+	}
+
+	/* HOUJI-SYSPATH: name the file behind a failed open/stat/connect. */
+	if (error != 0 && houji_sys_pid > 0 && pid == houji_sys_pid &&
+	    is_saved_state64(state)) {
+		static unsigned houji_sys_paths;
+		user_addr_t up = 0;
+		switch (code) {
+		case 5: case 398: case 338: case 220: case 266:
+			up = saved_state64(state)->x[0];
+			break;
+		case 463:
+			up = saved_state64(state)->x[1];
+			break;
+		default:
+			break;
+		}
+		if (up != 0 && houji_sys_paths < 120) {
+			char pbuf[96];
+			if (copyinstr(up, pbuf, sizeof(pbuf), NULL) == 0) {
+				houji_sys_paths++;
+				printf("HOUJI-SYSPATH: code %u err %d path %s\n",
+				    (unsigned)code, error, pbuf);
+			}
+		}
+	}
+
+	/* HOUJI-SYSRING: record the sampled process's calls with their errors. */
+	if (houji_sys_pid > 0 && pid == houji_sys_pid && is_saved_state64(state)) {
+		struct houji_sys_rec *ring = &houji_sys_ring[houji_sys_ring_at++ % 64];
+		ring->code = (uint32_t)code;
+		ring->error = error;
+		ring->pc = (uint64_t)saved_state64(state)->pc;
+		ring->lr = (uint64_t)saved_state64(state)->lr;
+		ring->x0 = (uint64_t)saved_state64(state)->x[0];
+	}
+
+	/* HOUJI-WI: name the work_interval_ctl (unix syscall 499) request and answer
+	 * that the sampled process just received. Its arguments are operation, type,
+	 * buffer and size, so a refused type is distinguishable from a bad size. */
+	{
+		extern boolean_t PE_parse_boot_argn(const char *, void *, int);
+		static int houji_wi_pid = -1;
+		static unsigned houji_wi_count;
+		if (houji_wi_pid < 0) {
+			int v = 0;
+			PE_parse_boot_argn("houji-sys-pid", &v, sizeof(v));
+			houji_wi_pid = v;
+		}
+		if (houji_wi_pid > 0 && pid == houji_wi_pid && code == 499 &&
+		    houji_wi_count < 24) {
+			houji_wi_count++;
+			printf("HOUJI-WI: op=%u type=%#x buf=%#llx size=%u rval=%#llx,%#llx "
+			    "error=%d comm=%s\n",
+			    (unsigned)uthread->uu_arg[0], (unsigned)uthread->uu_arg[1],
+			    (unsigned long long)uthread->uu_arg[2], (unsigned)uthread->uu_arg[3],
+			    (unsigned long long)uthread->uu_rval[0],
+			    (unsigned long long)uthread->uu_rval[1], error, proc->p_comm);
+		}
+	}
 
 #if CONFIG_MACF
 skip_syscall:
