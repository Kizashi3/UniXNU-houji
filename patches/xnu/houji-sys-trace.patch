diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
index 8a1ec42..2324b4f 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -79,6 +79,31 @@ __XNU_PRIVATE_EXTERN    int             syscalls_log[SYS_MAXSYSCALL];
 extern int mach_trap_count;
 #endif
 
+struct houji_sys_rec { uint32_t code; uint32_t pad; uint64_t pc, lr, x0; };
+static struct houji_sys_rec houji_sys_ring[64];
+static unsigned houji_sys_ring_at;
+static int houji_sys_pid = -1;
+
+/* Last calls of the sampled process, printed when it exits. */
+void
+houji_sys_dump(void)
+{
+	unsigned i;
+
+	if (houji_sys_ring_at == 0) {
+		return;
+	}
+	printf("HOUJI-SYSRING: last calls of pid %d\n", houji_sys_pid);
+	for (i = 0; i < 64; i++) {
+		struct houji_sys_rec *r = &houji_sys_ring[(houji_sys_ring_at + i) % 64];
+		if (r->code == 0) {
+			continue;
+		}
+		printf("HOUJI-SYSRING: code %u pc=%#llx lr=%#llx x0=%#llx\n",
+		    r->code, r->pc, r->lr, r->x0);
+	}
+}
+
 /*
  * Function:	unix_syscall
  *
@@ -102,6 +127,38 @@ unix_syscall(
 
 	code = arm_get_syscall_number(state);
 
+	/* HOUJI-SYS: sample one process's syscall sites (boot arg houji-sys-pid). */
+	{
+		extern boolean_t PE_parse_boot_argn(const char *, void *, int);
+		static unsigned houji_sys_seen;
+		static unsigned houji_sys_count;
+		if (houji_sys_pid < 0) {
+			int v = 0;
+			PE_parse_boot_argn("houji-sys-pid", &v, sizeof(v));
+			houji_sys_pid = v;
+		}
+		if (houji_sys_pid > 0 && proc_getpid(proc) == houji_sys_pid &&
+		    is_saved_state64(state)) {
+			struct houji_sys_rec *ring =
+			    &houji_sys_ring[houji_sys_ring_at++ % 64];
+			ring->code = (uint32_t)code;
+			ring->pc = (uint64_t)saved_state64(state)->pc;
+			ring->lr = (uint64_t)saved_state64(state)->lr;
+			ring->x0 = (uint64_t)saved_state64(state)->x[0];
+			houji_sys_seen++;
+			if (houji_sys_seen <= 40 || (houji_sys_seen & 31) == 0) {
+				if (houji_sys_count < 400) {
+					houji_sys_count++;
+					printf("HOUJI-SYS: pid %d code %u pc=%#llx lr=%#llx x0=%#llx\n",
+					    houji_sys_pid, (unsigned)code,
+					    (unsigned long long)saved_state64(state)->pc,
+					    (unsigned long long)saved_state64(state)->lr,
+					    (unsigned long long)saved_state64(state)->x[0]);
+				}
+			}
+		}
+	}
+
 #define unix_syscall_kprintf(x...)      /* kprintf("unix_syscall: " x) */
 
 	if (kdebug_enable && !code_is_kdebug_trace(code)) {
@@ -181,6 +238,30 @@ unix_syscall(
 	error = (*(callp->sy_call))(proc, &uthread->uu_arg[0], &(uthread->uu_rval[0]));
 	AUDIT_SYSCALL_EXIT(code, proc, uthread, error);
 
+	/* HOUJI-WI: name the work_interval_ctl (unix syscall 499) request and answer
+	 * that the sampled process just received. Its arguments are operation, type,
+	 * buffer and size, so a refused type is distinguishable from a bad size. */
+	{
+		extern boolean_t PE_parse_boot_argn(const char *, void *, int);
+		static int houji_wi_pid = -1;
+		static unsigned houji_wi_count;
+		if (houji_wi_pid < 0) {
+			int v = 0;
+			PE_parse_boot_argn("houji-sys-pid", &v, sizeof(v));
+			houji_wi_pid = v;
+		}
+		if (houji_wi_pid > 0 && pid == houji_wi_pid && code == 499 &&
+		    houji_wi_count < 24) {
+			houji_wi_count++;
+			printf("HOUJI-WI: op=%u type=%#x buf=%#llx size=%u rval=%#llx,%#llx "
+			    "error=%d comm=%s\n",
+			    (unsigned)uthread->uu_arg[0], (unsigned)uthread->uu_arg[1],
+			    (unsigned long long)uthread->uu_arg[2], (unsigned)uthread->uu_arg[3],
+			    (unsigned long long)uthread->uu_rval[0],
+			    (unsigned long long)uthread->uu_rval[1], error, proc->p_comm);
+		}
+	}
+
 #if CONFIG_MACF
 skip_syscall:
 #endif /* CONFIG_MACF */
