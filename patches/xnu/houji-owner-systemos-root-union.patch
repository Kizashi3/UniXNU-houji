--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -6992,6 +6992,129 @@
 #include <sys/reboot.h>
 
 /*
+ * HOUJI: SystemOS APFS volume as the upper layer of the root union.
+ * iOS 16 keeps /usr/lib and the dyld caches in the SystemOS cryptex; dyld
+ * resolves those paths against the root, so the cryptex must be visible at
+ * "/" itself. The upper layer is a real APFS volume mounted MNT_UNION, so
+ * the vnode pager serves Mach-O mmap. A bindfs overlay on /usr/lib is not
+ * equivalent: it is not MNT_ROOTFS and has no pager (BAD_MACHO).
+ */
+#if defined(XNU_OWNER_UNION_SYSTEMOS) && XNU_OWNER_UNION_SYSTEMOS
+#if !CONFIG_UNION_MOUNTS
+#error HOUJI root union requires CONFIG_UNION_MOUNTS
+#endif
+
+extern int native_verified_block_volume_device(const char *, dev_t *, char *, size_t);
+extern int mount(proc_t, struct mount_args *, int32_t *);
+extern uint64_t dyld_flags;
+extern void commpage_update_dyld_flags(uint64_t);
+
+volatile int houji_root_union_stage;
+volatile int houji_root_union_status = -1;
+volatile dev_t houji_root_union_device = NODEV;
+char houji_root_union_path[64];
+
+#ifndef HOUJI_SYSTEMOS_VOLUME_UUID
+#define HOUJI_SYSTEMOS_VOLUME_UUID ""
+#endif
+
+static int
+houji_systemos_root_union(proc_t p, user_addr_t scratch)
+{
+	char uuid[40] = { 0 };
+	char device_path[64] = { 0 };
+	uint8_t mount_data[0x150] = { 0 };
+	user_addr_t spec = scratch + 0x160;
+	uint64_t mount_flags = MNT_RDONLY;
+	uint16_t mount_mode = 1;
+	uint32_t anonymous_owner = 99;
+	struct mount_args request = {
+		.type  = scratch + 0x100,
+		.path  = scratch + 0x120,
+		.flags = 0,
+		.data  = scratch + 0x200,
+	};
+	int32_t result = 0;
+	int error;
+	vnode_t original_root = rootvnode;
+	vnode_t mounted_root = NULLVP;
+	mount_t cache_mount;
+	dev_t selected = NODEV;
+
+	if (!PE_parse_boot_argn("houji-systemos-uuid", uuid, sizeof(uuid)) ||
+	    strlen(uuid) != 36) {
+		strlcpy(uuid, HOUJI_SYSTEMOS_VOLUME_UUID, sizeof(uuid));
+	}
+	if (strlen(uuid) != 36) {
+		houji_root_union_status = EINVAL;
+		printf("HOUJI-UNION: no SystemOS volume UUID\n");
+		return EINVAL;
+	}
+	houji_root_union_stage = 1;
+
+	if (!native_verified_block_volume_device(uuid, &selected, device_path,
+	    sizeof(device_path))) {
+		houji_root_union_status = ENOENT;
+		printf("HOUJI-UNION: SystemOS volume %s not published\n", uuid);
+		return ENOENT;
+	}
+	strlcpy(houji_root_union_path, device_path, sizeof(houji_root_union_path));
+	houji_root_union_device = selected;
+	houji_root_union_stage = 2;
+
+	/* Same APFS user-mount payload as the houji root windows. */
+	memcpy(mount_data, &spec, sizeof(spec));
+	memcpy(mount_data + 8, &mount_flags, sizeof(mount_flags));
+	memcpy(mount_data + 16, &mount_mode, sizeof(mount_mode));
+	memcpy(mount_data + 0x144, &anonymous_owner, sizeof(anonymous_owner));
+	memcpy(mount_data + 0x148, &anonymous_owner, sizeof(anonymous_owner));
+
+	request.flags = (int)(MNT_RDONLY | MNT_UNION);
+	if ((error = copyout("apfs", request.type, 5)) != 0 ||
+	    (error = copyout("/", request.path, 2)) != 0 ||
+	    (error = copyout(device_path, spec, strlen(device_path) + 1)) != 0 ||
+	    (error = copyout(mount_data, request.data, sizeof(mount_data))) != 0) {
+		houji_root_union_status = error;
+		return error;
+	}
+	houji_root_union_stage = 3;
+
+	error = mount(p, &request, &result);
+	if (error) {
+		houji_root_union_status = error;
+		printf("HOUJI-UNION: mount failed %d\n", error);
+		return error;
+	}
+	houji_root_union_stage = 4;
+
+	if ((error = vnode_lookup("/", 0, &mounted_root, vfs_context_current())) != 0) {
+		houji_root_union_status = error;
+		return error;
+	}
+	cache_mount = vnode_mount(mounted_root);
+	if (!(vfs_flags(cache_mount) & MNT_UNION) ||
+	    vnode_mountedhere(original_root) != cache_mount ||
+	    rootvnode != mounted_root ||
+	    strcmp(vfs_statfs(cache_mount)->f_fstypename, "apfs") != 0) {
+		vnode_put(mounted_root);
+		houji_root_union_status = EAUTH;
+		printf("HOUJI-UNION: not a root APFS union\n");
+		return EAUTH;
+	}
+	vnode_put(mounted_root);
+	houji_root_union_stage = 5;
+
+	/* dyld bit 3 selects no ignition; the readonly root union serves images. */
+	dyld_flags |= UINT64_C(8);
+	commpage_update_dyld_flags(dyld_flags);
+	houji_root_union_status = 0;
+	printf("HOUJI-UNION: SystemOS root union ready dev=%s stage=%d\n",
+	    houji_root_union_path, houji_root_union_stage);
+	return 0;
+}
+#endif /* XNU_OWNER_UNION_SYSTEMOS */
+
+/*
  * load_init_program_at_path
  *
  * Description:	Load the "init" program; in most cases, this will be "launchd"
@@ -7148,6 +7271,15 @@
 	mach_vm_size_t map_page_size = vm_map_page_size(map);
 
 	(void) mach_vm_allocate_kernel(map, &scratch_addr, map_page_size, VM_FLAGS_ANYWHERE, VM_KERN_MEMORY_NONE);
+
+#if defined(XNU_OWNER_UNION_SYSTEMOS) && XNU_OWNER_UNION_SYSTEMOS
+	{
+		int union_error = houji_systemos_root_union(p, (user_addr_t)scratch_addr);
+		if (union_error) {
+			printf("HOUJI-UNION: continuing without SystemOS union, errno %d\n", union_error);
+		}
+	}
+#endif
 #if CONFIG_MEMORYSTATUS
 	(void) memorystatus_init_at_boot_snapshot();
 #endif /* CONFIG_MEMORYSTATUS */
