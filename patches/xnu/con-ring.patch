+/*
+ * HOUJI: capture every video-console byte into a fixed ring. Userspace
+ * /dev/console output (launchd, SpringBoard) reaches this function, so the
+ * ring is the only durable record of a userspace crash after reboot.
+ */
+#define HOUJI_CON_RING_SIZE (256 * 1024)
+char unixnu_con_ring_buf[HOUJI_CON_RING_SIZE];
+volatile uint32_t unixnu_con_ring_pos;
+volatile uint64_t unixnu_con_ring_total;
+
+void houji_con_ring_info(char **buf, uint32_t *size, uint32_t *pos,
+    uint64_t *total);
+
+void
+houji_con_ring_info(char **buf, uint32_t *size, uint32_t *pos, uint64_t *total)
+{
+	if (buf) *buf = unixnu_con_ring_buf;
+	if (size) *size = HOUJI_CON_RING_SIZE;
+	if (pos) *pos = unixnu_con_ring_pos;
+	if (total) *total = unixnu_con_ring_total;
+}
+
+static inline void
+houji_con_ring_putc(char c)
+{
+	uint32_t pos = unixnu_con_ring_pos;
+
+	unixnu_con_ring_buf[pos] = c;
+	unixnu_con_ring_pos = (pos + 1) & (HOUJI_CON_RING_SIZE - 1);
+	unixnu_con_ring_total++;
+}
+
 void
 vcputc_options(char c, __unused bool poll)
 {
+	houji_con_ring_putc(c);
+
+	/* HOUJI: while the boot UI owns the panel, keep kernel text in msgbuf. */
+	{
+		extern boolean_t PE_parse_boot_argn(const char *, void *, int);
+		static int houji_bootui = -1;
+		if (houji_bootui < 0) {
+			uint32_t on = 0;
+			PE_parse_boot_argn("houji-bootui", &on, sizeof(on));
+			houji_bootui = (on != 0);
+		}
+		if (houji_bootui) {
+			return;
+		}
+	}
+
