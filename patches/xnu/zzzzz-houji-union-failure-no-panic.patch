diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8030,6 +8030,13 @@
 	user_addr_t init_envp = USER_ADDR_NULL;
 #if defined(XNU_OWNER_CACHE_MOUNT) && XNU_OWNER_CACHE_MOUNT
 	int cache_error = native_owner_cache_prepare(p, (user_addr_t)scratch_addr, &init_envp);
-	if (cache_error) panic("offline owner SystemOS mount failed: %d", cache_error);
+	if (cache_error) {
+		/* HOUJI: keep the original root instead of panicking. The union mount
+		 * needs the SystemOS volume resolvable by UUID and accepted as a union
+		 * over "/"; on this board that volume arrives as a memdev disk, so a
+		 * failure here must cost the union, not the boot. */
+		printf("HOUJI-UNION: SystemOS root union failed: %d; continuing on the original root\n",
+		    cache_error);
+	}
 #endif
 #if defined(XNU_OWNER_DATA_MOUNT) && XNU_OWNER_DATA_MOUNT
 	int data_error = native_owner_data_prepare(p, (user_addr_t)scratch_addr);
