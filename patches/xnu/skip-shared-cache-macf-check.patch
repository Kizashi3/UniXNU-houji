--- a/bsd/kern/ubc_subr.c
+++ b/bsd/kern/ubc_subr.c
@@ -4348,6 +4348,26 @@
  * This function must be called when the storage for the code signature can
  * no longer change.
  */
+/*
+ * HOUJI-CSLAX-v1: the shared cache's entitlements blob cannot be accelerated by AMFI on this
+ * platform, which currently fails the whole code signature registration. Allow the boot to treat
+ * that as "no accelerated entitlements" instead.
+ */
+extern boolean_t PE_parse_boot_argn(const char *arg_string, void *arg_ptr, int arg_len);
+
+static int unixnu_cs_lax_parsed;
+static uint32_t unixnu_cs_lax;
+
+static boolean_t
+unixnu_cs_lax_enabled(void)
+{
+	if (unixnu_cs_lax_parsed == 0) {
+		unixnu_cs_lax_parsed = 1;
+		PE_parse_boot_argn("cs_blob_lax", &unixnu_cs_lax, sizeof(unixnu_cs_lax));
+	}
+	return unixnu_cs_lax != 0;
+}
