diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index ff5296d..e0208e7 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -60,6 +60,7 @@
 #include <vm/pmap.h>
 #include <vm/vm_fault.h>
 #include <vm/vm_kern.h>
+#include <vm/vm_map.h>
 
 #include <sys/errno.h>
 #include <sys/kdebug.h>
@@ -1678,6 +1679,94 @@ handle_user_abort(arm_saved_state_t *state, uint32_t esr, vm_offset_t fault_addr
 		exit_with_jit_exception(current_proc());
 	}
 
+	{
+		arm_saved_state64_t *ss64 = saved_state64(state);
+		uint64_t tpidrro = 0;
+		uint64_t tpidr = 0;
+		uint32_t insn_pc = 0;
+		uint32_t insn_lr = 0;
+		uint32_t win[8];
+		__asm__ volatile("mrs %0, TPIDRRO_EL0" : "=r"(tpidrro));
+		__asm__ volatile("mrs %0, TPIDR_EL0" : "=r"(tpidr));
+		copyin((user_addr_t)get_saved_state_pc(state), (void *)&insn_pc, sizeof(insn_pc));
+		copyin((user_addr_t)ss64->lr, (void *)&insn_lr, sizeof(insn_lr));
+		printf("HOUJI-FAULT-v2: task %p pc %#llx insn %08x lr %#llx linsn %08x far %#llx esr %#llx prot %#x code %#llx sp %#llx x0 %#llx x1 %#llx x2 %#llx x3 %#llx x4 %#llx x5 %#llx x6 %#llx x7 %#llx x8 %#llx tp %#llx tpidr %#llx\n",
+		    (void *)get_threadtask(thread),
+		    (unsigned long long)get_saved_state_pc(state), (unsigned)insn_pc,
+		    (unsigned long long)ss64->lr, (unsigned)insn_lr,
+		    (unsigned long long)fault_addr,
+		    (unsigned long long)esr,
+		    (unsigned)fault_type,
+		    (unsigned long long)codes[0],
+		    (unsigned long long)ss64->sp,
+		    (unsigned long long)ss64->x[0],
+		    (unsigned long long)ss64->x[1],
+		    (unsigned long long)ss64->x[2],
+		    (unsigned long long)ss64->x[3],
+		    (unsigned long long)ss64->x[4],
+		    (unsigned long long)ss64->x[5],
+		    (unsigned long long)ss64->x[6],
+		    (unsigned long long)ss64->x[7],
+		    (unsigned long long)ss64->x[8],
+		    (unsigned long long)tpidrro,
+		    (unsigned long long)tpidr);
+		bzero(win, sizeof(win));
+		copyin((user_addr_t)(get_saved_state_pc(state) - 24), (void *)win, sizeof(win));
+		printf("HOUJI-FAULT-v2-WIN: pc %#llx w0 %08x w1 %08x w2 %08x w3 %08x w4 %08x w5 %08x w6 %08x w7 %08x\n",
+		    (unsigned long long)get_saved_state_pc(state),
+		    (unsigned)win[0], (unsigned)win[1], (unsigned)win[2], (unsigned)win[3],
+		    (unsigned)win[4], (unsigned)win[5], (unsigned)win[6], (unsigned)win[7]);
+	}
+	{
+		arm_saved_state64_t *fs64 = saved_state64(state);
+		vm_map_t fmap = get_task_map(current_task());
+		vm_map_entry_t fentry = VM_MAP_ENTRY_NULL;
+		vm_map_lock_read(fmap);
+		if (vm_map_lookup_entry(fmap, (vm_map_offset_t)fault_addr, &fentry)) {
+			printf("HOUJI-FAULT-MAP: far %#llx IN [%#llx,%#llx) prot %#x max %#x\n",
+			    (unsigned long long)fault_addr,
+			    (unsigned long long)fentry->vme_start, (unsigned long long)fentry->vme_end,
+			    (unsigned)fentry->protection, (unsigned)fentry->max_protection);
+		} else {
+			printf("HOUJI-FAULT-MAP: far %#llx NO-ENTRY prev [%#llx,%#llx) prot %#x\n",
+			    (unsigned long long)fault_addr,
+			    (unsigned long long)fentry->vme_start, (unsigned long long)fentry->vme_end,
+			    (unsigned)fentry->protection);
+		}
+		vm_map_unlock_read(fmap);
+		{
+			mach_vm_address_t aii = task_get_all_image_info_addr(current_task());
+			if (aii) {
+				uint8_t aib[0xC0];
+				if (copyin((user_addr_t)aii, aib, sizeof(aib)) == 0) {
+					uint32_t ver = *(uint32_t *)(void *)(aib + 0);
+					uint32_t cnt = *(uint32_t *)(void *)(aib + 4);
+					uint64_t q80 = *(uint64_t *)(void *)(aib + 0x80);
+					uint64_t q88 = *(uint64_t *)(void *)(aib + 0x88);
+					uint64_t q90 = *(uint64_t *)(void *)(aib + 0x90);
+					uint64_t q98 = *(uint64_t *)(void *)(aib + 0x98);
+					uint64_t qa0 = *(uint64_t *)(void *)(aib + 0xA0);
+					uint64_t qa8 = *(uint64_t *)(void *)(aib + 0xA8);
+					uint64_t qb0 = *(uint64_t *)(void *)(aib + 0xB0);
+					uint64_t qb8 = *(uint64_t *)(void *)(aib + 0xB8);
+					printf("HOUJI-DYLDINFO: aii %#llx ver %u cnt %u q80 %#llx q88 %#llx q90 %#llx q98 %#llx qA0 %#llx qA8 %#llx qB0 %#llx qB8 %#llx\n",
+					    (unsigned long long)aii, ver, cnt,
+					    (unsigned long long)q80, (unsigned long long)q88,
+					    (unsigned long long)q90, (unsigned long long)q98,
+					    (unsigned long long)qa0, (unsigned long long)qa8,
+					    (unsigned long long)qb0, (unsigned long long)qb8);
+				}
+			}
+		}
+		uint64_t stk[8];
+		bzero(stk, sizeof(stk));
+		copyin((user_addr_t)fs64->sp, (void *)stk, sizeof(stk));
+		printf("HOUJI-FAULT-STK: sp %#llx [%#llx %#llx %#llx %#llx %#llx %#llx %#llx %#llx]\n",
+		    (unsigned long long)fs64->sp,
+		    (unsigned long long)stk[0], (unsigned long long)stk[1], (unsigned long long)stk[2],
+		    (unsigned long long)stk[3], (unsigned long long)stk[4], (unsigned long long)stk[5],
+		    (unsigned long long)stk[6], (unsigned long long)stk[7]);
+	}
 	exception_triage(exc, codes, numcodes);
 	__builtin_unreachable();
 }
