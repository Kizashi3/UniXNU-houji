+/*
+ * HOUJI-UFS-MD: define a md device backed by a named userdata window.  The device reports
+ * the window length, so an APFS container inside it passes nx_dev_init's size sanity check
+ * while costing no RAM at all.
+ */
+int
+mdevadd_ufs(int devid, const char *name, uint64_t bytes)
+{
+	int rc;
+	unsigned int pages = (unsigned int)(bytes >> 12);
+
+	rc = mdevadd(devid, 0, pages, 0);
+	if (rc >= 0) {
+		int slot = (devid >= 0) ? devid : (rc & 0xffff);
+		if (name) {
+			unsigned n = 0;
+			while (n + 1 < sizeof(mdev[slot].mdUfsName) && name[n]) {
+				mdev[slot].mdUfsName[n] = name[n];
+				n++;
+			}
+			mdev[slot].mdUfsName[n] = 0;
+		}
+		mdev[slot].mdFlags |= mdUfs;
+		printf("HOUJI-UFS-MD: md%x window=\"%s\" bytes=%llu\n", slot,
+				    name ? name : "", (unsigned long long)bytes);
+	}
+	return rc;
+}
