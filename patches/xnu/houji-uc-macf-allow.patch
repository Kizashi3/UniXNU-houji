+/* HOUJI-UC: this port's framebuffer driver publishes its own user-client class. The
+ * sandbox profiles admit Apple's IOMobileFramebufferUserClient by name, so IOServiceOpen
+ * for the port's class is refused by MACF before a single selector can arrive. Admit
+ * exactly this class name and nothing else. */
+static bool
+IOHoujiPortUserClient(IOUserClient *client)
+{
+	static const char houjiClass[] = "HoujiLegacyClient";
+	const char *name;
+
+	if (client == nullptr)
+		return false;
+	name = client->getMetaClass()->getClassName();
+	if (name == nullptr)
+		return false;
+	for (unsigned i = 0; i < sizeof(houjiClass); i++) {
+		if (name[i] != houjiClass[i])
+			return false;
+	}
+	return true;
+}
