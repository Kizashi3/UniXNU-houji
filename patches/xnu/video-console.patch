diff --git a/osfmk/console/video_console.c b/osfmk/console/video_console.c
--- a/osfmk/console/video_console.c
+++ b/osfmk/console/video_console.c
@@ -3057,6 +3070,14 @@ vcattach(void)
 {
 	vm_initialized = TRUE;
 
+	/* HOUJI: the boot framebuffer is handed to us in graphics mode, which leaves
+	   gc_enabled false and disableConsoleOutput true, so no kernel log ever reaches
+	   the panel. Claim the console in text mode before the acquisition below so the
+	   msgbuf replay paints the boot log. */
+	gc_graphics_boot = FALSE;
+	gc_desire_text = TRUE;
+	disableConsoleOutput = FALSE;
+
 #if defined(CONFIG_VC_PROGRESS_METER_SUPPORT)
 	const boot_args * bootargs  = (typeof(bootargs))PE_state.bootArgs;
 
