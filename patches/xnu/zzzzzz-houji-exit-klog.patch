diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1892,6 +1892,14 @@
 	task_t task = proc_task(p);
 
 
+	/* HOUJI-EXIT: persist crash exit reasons (namespace/code/description) to the log. */
+	if (p->p_exit_reason != OS_REASON_NULL) {
+		char *houji_desc = exit_reason_get_string_desc(p->p_exit_reason);
+		printf("HOUJI-EXIT: pid %d %s ns %d code 0x%llx desc %s\n",
+		    proc_getpid(p), p->p_comm, p->p_exit_reason->osr_namespace,
+		    p->p_exit_reason->osr_code, houji_desc ? houji_desc : "none");
+	}
+
 	if (p->p_crash_behavior != 0 || p == initproc) {
 		proc_handle_critical_exit(p, rv);
 	}
