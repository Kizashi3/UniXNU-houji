diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -94,6 +94,7 @@
 #include <sys/namei.h>
 #include <sys/mount_internal.h>
 #include <sys/vnode_internal.h>
+#include <sys/fcntl.h>
 #include <sys/file_internal.h>
 #include <sys/stat.h>
 #include <sys/uio_internal.h>
@@ -7138,6 +7139,349 @@
  * 3		2		NA		/usr/appleinternal/sbin/launchd.development
  * 4		3		1		/sbin/launchd
  */
+/*
+ * UniXNU: the SystemOS cryptex arrives as a second memory disk (md1). APFS mounts
+ * a volume, not the container, so try the volume device nodes first and log the
+ * errno of each attempt. Only mount(2) is used here; probing paths with
+ * vnode_lookup deadlocks in this context.
+ */
+static int
+houji_rd2_try_mount(proc_t p, user_addr_t scratch, const char *dev, const char *fstype,
+    const char *mtpath, uint64_t mount_flags)
+{
+	user64_addr_t spec = scratch + 0x160;
+	uint8_t payload[0x150] = {0};
+	uint16_t mode = 1;
+	uint32_t anonymous_owner = 99;
+	struct mount_args request = {.type = scratch + 0x100, .path = scratch + 0x120,
+	    .flags = (int)mount_flags, .data = scratch + 0x200};
+	int32_t result = 0;
+	int error;
+
+	memcpy(payload, &spec, sizeof(spec));
+	memcpy(payload + 8, &mount_flags, sizeof(mount_flags));
+	memcpy(payload + 16, &mode, sizeof(mode));
+	memcpy(payload + 0x144, &anonymous_owner, sizeof(anonymous_owner));
+	memcpy(payload + 0x148, &anonymous_owner, sizeof(anonymous_owner));
+	if ((error = copyout(fstype, request.type, strlen(fstype) + 1)) != 0 ||
+	    (error = copyout(mtpath, request.path, strlen(mtpath) + 1)) != 0 ||
+	    (error = copyout(dev, spec, strlen(dev) + 1)) != 0 ||
+	    (error = copyout(payload, request.data, sizeof(payload))) != 0) {
+		return error;
+	}
+	error = mount(p, &request, &result);
+	if (error != 0) {
+		printf("HOUJI-RD2: mount %s on %s error %d\n", dev, mtpath, error);
+	} else {
+		printf("HOUJI-RD2: mounted %s on %s\n", dev, mtpath);
+	}
+	return error;
+}
+
+extern volatile int native_bindfs_boot_mount __attribute__((weak));
+struct mount *houji_usrlib_mount = NULL;
+
+static int
+houji_rd2_mkdir(proc_t p, user_addr_t scratch, const char *path)
+{
+	struct mkdirat_args args;
+	int32_t retval = 0;
+	int error;
+
+	if ((error = copyout(path, scratch + 0x360, strlen(path) + 1)) != 0) {
+		return error;
+	}
+	args.fd = AT_FDCWD;
+	args.path = scratch + 0x360;
+	args.mode = 0755;
+	return mkdirat(p, &args, &retval);
+}
+
+static int
+houji_rd2_copy(vfs_context_t ctx, const char *src, const char *dst,
+    uint64_t *bytes_out, uint32_t *magic_out)
+{
+	static uint8_t houji_copy_buf[65536];
+	uint32_t houji_copy_magic = 0;
+	vnode_t svp = NULLVP, dvp = NULLVP;
+	off_t offset = 0;
+	int resid = 0;
+	int error;
+
+	error = vnode_lookup(src, 0, &svp, ctx);
+	if (error) {
+		return error;
+	}
+	error = vnode_open(dst, O_CREAT | O_TRUNC | O_WRONLY, 0644, 0, &dvp, ctx);
+	if (error) {
+		vnode_put(svp);
+		return error;
+	}
+	for (;;) {
+		int got;
+
+		resid = 0;
+		error = vn_rdwr(UIO_READ, svp, (caddr_t)houji_copy_buf, (int)sizeof(houji_copy_buf),
+		    offset, UIO_SYSSPACE, 0, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (error) {
+			break;
+		}
+		got = (int)sizeof(houji_copy_buf) - resid;
+		if (got <= 0) {
+			break;
+		}
+		if (offset == 0 && got >= 4) {
+			memcpy(&houji_copy_magic, houji_copy_buf, sizeof(houji_copy_magic));
+		}
+		resid = 0;
+		error = vn_rdwr(UIO_WRITE, dvp, (caddr_t)houji_copy_buf, got, offset,
+		    UIO_SYSSPACE, IO_UNIT, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (error) {
+			break;
+		}
+		offset += got;
+	}
+	vnode_close(dvp, 0, ctx);
+	vnode_put(svp);
+	if (bytes_out) {
+		*bytes_out = (uint64_t)offset;
+	}
+	if (magic_out) {
+		*magic_out = houji_copy_magic;
+	}
+	return error;
+}
+
+static int
+houji_rd2_bind(proc_t p, user_addr_t scratch, const char *source, const char *point)
+{
+	struct mount_args request = {.type = scratch + 0x900, .path = scratch + 0x920,
+	    .flags = MNT_RDONLY, .data = scratch + 0xA00};
+	int32_t result = 0;
+	int error;
+
+	if ((error = copyout("bindfs", request.type, 7)) != 0 ||
+	    (error = copyout(point, request.path, strlen(point) + 1)) != 0 ||
+	    (error = copyout(source, request.data, strlen(source) + 1)) != 0) {
+		return error;
+	}
+	if (&native_bindfs_boot_mount) {
+		native_bindfs_boot_mount = 1;
+	}
+	error = mount(p, &request, &result);
+	if (&native_bindfs_boot_mount) {
+		native_bindfs_boot_mount = 0;
+	}
+	if (error == 0 && strcmp(point, "/usr/lib") == 0) {
+		vnode_t mv = NULLVP;
+
+		if (vnode_lookup("/usr/lib", 0, &mv, vfs_context_current()) == 0) {
+			houji_usrlib_mount = vnode_mount(mv);
+			vnode_put(mv);
+			printf("HOUJI-CRYPTEX: overlay mount recorded\n");
+		}
+	}
+	return error;
+}
+
+static int
+houji_rd2_stage_usrlib(proc_t p, user_addr_t scratch)
+{
+	vfs_context_t ctx = vfs_context_current();
+	int mk, e1, e2;
+
+	mk = houji_rd2_mkdir(p, scratch, "/private/var/usrlib");
+	if (mk != 0 && mk != EEXIST) {
+		printf("HOUJI-CRYPTEX: usrlib mkdir -> %d\n", mk);
+		return mk;
+	}
+	uint64_t dyld_bytes = 0, tramp_bytes = 0;
+	uint32_t dyld_magic = 0, tramp_magic = 0;
+
+	e1 = houji_rd2_copy(ctx, "/usr/lib/dyld", "/private/var/usrlib/dyld",
+	    &dyld_bytes, &dyld_magic);
+	e2 = houji_rd2_copy(ctx, "/private/preboot/usr/lib/libobjc-trampolines.dylib",
+	    "/private/var/usrlib/libobjc-trampolines.dylib", &tramp_bytes, &tramp_magic);
+	printf("HOUJI-CRYPTEX: copy dyld=%d bytes=%llu magic=%08x trampolines=%d bytes=%llu magic=%08x\n",
+	    e1, (unsigned long long)dyld_bytes, dyld_magic, e2,
+	    (unsigned long long)tramp_bytes, tramp_magic);
+	if (e1 != 0 || e2 != 0) {
+		return e1 ? e1 : e2;
+	}
+	/* Only a plausible Mach-O dyld may replace /usr/lib/dyld. */
+	if (dyld_bytes < 65536 || (dyld_magic != 0xfeedfacf && dyld_magic != 0xfeedface &&
+	    dyld_magic != 0xcafebabe && dyld_magic != 0xbebafeca)) {
+		printf("HOUJI-CRYPTEX: dyld copy rejected\n");
+		return -4096;
+	}
+	return 0;
+}
+
+extern struct vnode *rootvnode;
+
+static int
+houji_rd2_rootfix(proc_t p, user_addr_t scratch)
+{
+	vfs_context_t ctx = vfs_context_current();
+	uint64_t bytes = 0;
+	uint32_t magic = 0;
+	int error;
+
+	(void)p;
+	(void)scratch;
+	error = houji_rd2_copy(ctx,
+	    "/private/preboot/usr/lib/libobjc-trampolines.dylib",
+	    "/usr/lib/libobjc-trampolines.dylib", &bytes, &magic);
+	printf("HOUJI-ROOTFIX: copy bytes=%llu magic=%08x err=%d\n",
+	    (unsigned long long)bytes, magic, error);
+	return error;
+}
+
+static int
+houji_rd2_mount(proc_t p, user_addr_t scratch, user_addr_t *envp)
+{
+	static const char *const devices[] = {"/dev/md1s1", "/dev/md1s2", "/dev/md1"};
+	char rd2[64];
+	user64_addr_t environment_vector[3] = {scratch + 0x400, scratch + 0x480, USER_ADDR_NULL};
+	const char *environment = "DYLD_SHARED_CACHE_DIR=/private/preboot/System/Library/Caches/com.apple.dyld";
+	/*
+	 * HOUJI-CRYPTEX: /usr/lib lives on the SystemOS volume mounted at
+	 * /private/preboot; dyld resolves missing absolute paths through this
+	 * fallback (upstream XNU_OWNER_CRYPTEX_FILES sets the same variable).
+	 */
+	const char *fallback = "DYLD_FALLBACK_LIBRARY_PATH=/private/preboot/usr/lib";
+	unsigned int index;
+	int error = EINVAL;
+
+	if (!PE_parse_boot_argn("rd2", rd2, (int)sizeof(rd2)) &&
+	    !PE_parse_boot_argn("ufs-md", rd2, (int)sizeof(rd2))) {
+		return 0;
+	}
+	printf("HOUJI-RD2: mount helper entered\n");
+	for (index = 0; index < sizeof(devices) / sizeof(devices[0]); index++) {
+		printf("HOUJI-RD2: trying %s\n", devices[index]);
+		error = houji_rd2_try_mount(p, scratch, devices[index], "apfs", "/private/preboot", MNT_RDONLY);
+		if (error == 0) {
+			break;
+		}
+	}
+	if (error != 0) {
+		/* HOUJI: single-window merged roots have no SystemOS device; keep going
+		 * so the Data mount below still runs. */
+		printf("HOUJI-RD2: no SystemOS device (%d), continuing ", error);
+		error = 0;
+	}
+	/*
+	 * HOUJI-DATA: the writable Data ramdisk (FAT, md2) goes to /private/var. Without it launchd
+	 * has nowhere to write state, and a missing or unformatted md2 only costs the mount attempt.
+	 */
+	{
+		int data_error = -1;
+#if defined(XNU_NATIVE_RAM_BLOCK) && XNU_NATIVE_RAM_BLOCK
+		extern int native_ram_block_volume_seed(const char *, dev_t *, char *, size_t,
+		    uint64_t *, uint64_t *, uint8_t *);
+		dev_t ramdev = NODEV;
+		char rampath[64] = {0};
+		uint64_t seedbase = 0, seedbytes = 0;
+		uint8_t seedsha[32] = {0};
+		if (native_ram_block_volume_seed("houji-data", &ramdev, rampath, sizeof(rampath),
+		    &seedbase, &seedbytes, seedsha)) {
+			printf("HOUJI-DATA: ram-block %s dev %d\n", rampath, (int)ramdev);
+			data_error = houji_rd2_try_mount(p, scratch, rampath, "apfs", "/private/var", 0);
+			if (data_error != 0) data_error = houji_rd2_try_mount(p, scratch, rampath, "hfs", "/private/var", 0);
+		} else {
+			printf("HOUJI-DATA: no ram-block device\n");
+		}
+#endif
+		if (data_error != 0) {
+			data_error = houji_rd2_try_mount(p, scratch, "", "hfs", "/private/var", 0);
+			if (data_error != 0) data_error = houji_rd2_try_mount(p, scratch, "/dev/md2", "apfs", "/private/var", 0);
+			if (data_error == 0) printf("HOUJI-DATA: mounted hfs on /private/var\n");
+			if (data_error != 0) {
+				printf("HOUJI-DATA: continuing without /private/var (%d)\n", data_error);
+			}
+		}
+	}
+	/*
+	 * HOUJI-CRYPTEX: optional staging of /usr/lib files (off by default).
+	 * Measured 2026-11-12 (run 286): a valid staged dyld (525212 bytes,
+	 * magic feedfacf) bound over /usr/lib still makes the kernel reject the
+	 * dylinker as BAD_MACHO, so this path is only enabled explicitly for
+	 * experiments. The merged-root image (plan A) must keep it off.
+	 */
+	{
+		int usrlib_bind = 0;
+
+		PE_parse_boot_argn("houji-usrlib-bind", &usrlib_bind, sizeof(usrlib_bind));
+		if (usrlib_bind) {
+			int stage_error = houji_rd2_stage_usrlib(p, scratch);
+
+			if (stage_error == 0) {
+				printf("HOUJI-CRYPTEX: bind usrlib -> %d\n",
+				    houji_rd2_bind(p, scratch, "/private/var/usrlib", "/usr/lib"));
+			} else {
+				printf("HOUJI-CRYPTEX: bind skipped (%d)\n", stage_error);
+			}
+		} else {
+			printf("HOUJI-CRYPTEX: usrlib bind disabled\n");
+		}
+	}
+	/*
+	 * HOUJI-ROOTFIX (off by default): the root is a RAM window mounted read-only
+	 * by policy. Try an MNT_UPDATE remount to rw; when it succeeds, copy the one
+	 * SystemOS library that dyld cannot find into the real /usr/lib path, which
+	 * keeps APFS and satisfies the sandbox without any mount or bind.
+	 */
+	{
+		int rootfix = 0;
+
+		PE_parse_boot_argn("houji-rootfix", &rootfix, sizeof(rootfix));
+		if (rootfix) {
+			mount_t rootfs = vnode_mount(rootvnode);
+			uint64_t rootflags = rootfs ? vfs_flags(rootfs) : 0;
+
+			printf("HOUJI-ROOTFIX: root flags=0x%llx ro=%d\n",
+			    (unsigned long long)rootflags,
+			    (rootflags & MNT_RDONLY) != 0);
+			if (rootflags & MNT_RDONLY) {
+				int uerr = houji_rd2_try_mount(p, scratch, "", "apfs", "/", MNT_UPDATE);
+
+				rootflags = rootfs ? vfs_flags(rootfs) : 0;
+				printf("HOUJI-ROOTFIX: remount err=%d flags=0x%llx ro=%d\n",
+				    uerr, (unsigned long long)rootflags,
+				    (rootflags & MNT_RDONLY) != 0);
+			}
+			if (!(rootflags & MNT_RDONLY)) {
+				printf("HOUJI-ROOTFIX: result=%d\n", houji_rd2_rootfix(p, scratch));
+			}
+		}
+	}
+	/*
+	 * HOUJI-OWN: the merged root is mounted with MNT_IGNORE_OWNERSHIP, so every
+	 * vnode reports uid/gid 99 and launchd rejects every plist with error 122.
+	 * The volume carries real ownership, so clear the flag on the root mount.
+	 */
+	{
+		mount_t rootfs = vnode_mount(rootvnode);
+
+		if (rootfs && (vfs_flags(rootfs) & MNT_IGNORE_OWNERSHIP)) {
+			vfs_clearflags(rootfs, MNT_IGNORE_OWNERSHIP);
+			printf("HOUJI-OWN: cleared MNT_IGNORE_OWNERSHIP, flags now 0x%x\n",
+			    vfs_flags(rootfs));
+		} else {
+			printf("HOUJI-OWN: root flags 0x%x (ignore-ownership not set)\n",
+			    rootfs ? vfs_flags(rootfs) : 0);
+		}
+	}
+	if ((error = copyout(environment, scratch + 0x400, strlen(environment) + 1)) != 0 ||
+	    (error = copyout(fallback, scratch + 0x480, strlen(fallback) + 1)) != 0 ||
+	    (error = copyout(environment_vector, scratch + 0x500, sizeof(environment_vector))) != 0) {
+		return error;
+	}
+	*envp = scratch + 0x500;
+	return 0;
+}
