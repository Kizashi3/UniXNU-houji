+/*
+ * HOUJI-DATA-TWEAK: the System volume is read-only and the merged root cannot
+ * be remounted, but /private/var is the writable Data volume.  Write the
+ * post-Setup preferences there before launchd starts.  The Data seed already
+ * contains the activation ark; replacing disabled.plist is what re-enables
+ * CommCenter, identityservicesd, locationd, and icon services for the Home
+ * Screen path, while keeping watchdogd and datamigrator out of the boot.
+ */
+#define HOUJI_PLIST_HEADER \
+	"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" \
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" " \
+	"\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+
+static int
+houji_write_data_file(const char *path, const char *data, size_t len,
+    uid_t uid, gid_t gid, mode_t mode)
+{
+	vfs_context_t ctx = vfs_context_create(NULL);
+	vnode_t vp = NULLVP;
+	uio_t uio;
+	int error;
+
+	error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, mode, 0, &vp, ctx);
+	if (error != 0) {
+		printf("HOUJI-DATA-TWEAK: open %s err=%d\n", path, error);
+		vfs_context_rele(ctx);
+		return error;
+	}
+	uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+	if (uio == NULL) {
+		vnode_close(vp, FWRITE, ctx);
+		vfs_context_rele(ctx);
+		printf("HOUJI-DATA-TWEAK: uio alloc failed for %s\n", path);
+		return ENOMEM;
+	}
+	uio_addiov(uio, (uintptr_t)data, len);
+	error = VNOP_WRITE(vp, uio, 0, ctx);
+	uio_free(uio);
+	if (error == 0) {
+		error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	vnode_close(vp, FWRITE, ctx);
+	if (vnode_lookup(path, 0, &vp, ctx) == 0) {
+		struct vnode_attr va;
+
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_uid);
+		VATTR_WANTED(&va, va_gid);
+		VATTR_WANTED(&va, va_mode);
+		VATTR_SET(&va, va_uid, uid);
+		VATTR_SET(&va, va_gid, gid);
+		VATTR_SET(&va, va_mode, mode);
+		if (vnode_setattr(vp, &va, ctx) != 0) {
+			printf("HOUJI-DATA-TWEAK: setattr %s failed\n", path);
+		}
+		vnode_put(vp);
+	}
+	printf("HOUJI-DATA-TWEAK: %s write=%d len=%u\n", path, error,
+	    (unsigned)len);
+	vfs_context_rele(ctx);
+	return error;
+}
