+static void
+houji_own_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	houji_install_mobileactivation_plist();
+	houji_apply_data_tweaks();
+	houji_own_tree("/System/Library/LaunchDaemons", 0);
+	houji_own_tree("/System/Library/LaunchAgents", 0);
+	printf("HOUJI-OWN-FIX: launchd trees re-owned\n");
+	__atomic_store_n(&houji_own_done, 1, __ATOMIC_RELEASE);
+	wakeup((void *)&houji_own_done);
+}
+
+static void
+houji_own_run(void)
+{
+	thread_t th = THREAD_NULL;
+	int spin;
+
+	if (kernel_thread_start(houji_own_thread, NULL, &th) != KERN_SUCCESS) {
+		return;
+	}
+	thread_deallocate(th);
+	for (spin = 0; spin < 600; spin++) {
+		if (__atomic_load_n(&houji_own_done, __ATOMIC_ACQUIRE)) {
+			break;
+		}
+		tsleep((void *)&houji_own_done, PRIBIO, "houji-own", 5);
+	}
+	printf("HOUJI-OWN-FIX: done=%d\n", __atomic_load_n(&houji_own_done, __ATOMIC_ACQUIRE));
+}
