+/*
+ * UniXNU: the SystemOS cryptex arrives as a second memory disk (md1). APFS mounts
+ * a volume, not the container, so try the volume device nodes first and log the
+ * errno of each attempt. Only mount(2) is used here; probing paths with
+ * vnode_lookup deadlocks in this context.
+ */
+static int
+houji_rd2_try_mount(proc_t p, user_addr_t scratch, const char *dev, const char *fstype,
+    const char *mtpath, uint64_t mount_flags)
+{
+	user64_addr_t spec = scratch + 0x160;
+	uint8_t payload[0x150] = {0};
+	uint16_t mode = 1;
+	uint32_t anonymous_owner = 99;
+	struct mount_args request = {.type = scratch + 0x100, .path = scratch + 0x120,
+	    .flags = (int)mount_flags, .data = scratch + 0x200};
+	int32_t result = 0;
+	int error;
+
+	memcpy(payload, &spec, sizeof(spec));
+	memcpy(payload + 8, &mount_flags, sizeof(mount_flags));
+	memcpy(payload + 16, &mode, sizeof(mode));
+	memcpy(payload + 0x144, &anonymous_owner, sizeof(anonymous_owner));
+	memcpy(payload + 0x148, &anonymous_owner, sizeof(anonymous_owner));
+	if ((error = copyout(fstype, request.type, strlen(fstype) + 1)) != 0 ||
+	    (error = copyout(mtpath, request.path, strlen(mtpath) + 1)) != 0 ||
+	    (error = copyout(dev, spec, strlen(dev) + 1)) != 0 ||
+	    (error = copyout(payload, request.data, sizeof(payload))) != 0) {
+		return error;
+	}
+	error = mount(p, &request, &result);
+	if (error != 0) {
+		printf("HOUJI-RD2: mount %s on %s error %d\n", dev, mtpath, error);
+	} else {
+		printf("HOUJI-RD2: mounted %s on %s\n", dev, mtpath);
+	}
+	return error;
+}
+
+static int
+houji_rd2_mount(proc_t p, user_addr_t scratch, user_addr_t *envp)
+{
+	static const char *const devices[] = {"/dev/md1s1", "/dev/md1s2", "/dev/md1"};
+	char rd2[64];
+	user64_addr_t environment_vector[2] = {scratch + 0x400, USER_ADDR_NULL};
+	const char *environment = "DYLD_SHARED_CACHE_DIR=/private/preboot/System/Library/Caches/com.apple.dyld";
+	unsigned int index;
+	int error = EINVAL;
+
+	if (!PE_parse_boot_argn("rd2", rd2, (int)sizeof(rd2)) &&
+	    !PE_parse_boot_argn("ufs-md", rd2, (int)sizeof(rd2))) {
+		return 0;
+	}
+	printf("HOUJI-RD2: mount helper entered\n");
+	for (index = 0; index < sizeof(devices) / sizeof(devices[0]); index++) {
+		printf("HOUJI-RD2: trying %s\n", devices[index]);
+		error = houji_rd2_try_mount(p, scratch, devices[index], "apfs", "/private/preboot", MNT_RDONLY);
+		if (error == 0) {
+			break;
+		}
+	}
+	if (error != 0) {
+		return error;
+	}
+	/*
+	 * HOUJI-DATA: the writable Data ramdisk (FAT, md2) goes to /private/var. Without it launchd
+	 * has nowhere to write state, and a missing or unformatted md2 only costs the mount attempt.
+	 */
+	{
+		int data_error = houji_rd2_try_mount(p, scratch, "/dev/md2", "apfs", "/private/var", 0);
+		if (data_error != 0) {
+			printf("HOUJI-DATA: continuing without /private/var (%d)\n", data_error);
+		}
+	}
+	if ((error = copyout(environment, scratch + 0x400, strlen(environment) + 1)) != 0 ||
+	    (error = copyout(environment_vector, scratch + 0x500, sizeof(environment_vector))) != 0) {
+		return error;
+	}
+	*envp = scratch + 0x500;
+	return 0;
+}
