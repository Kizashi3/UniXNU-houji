+/*
+ * HOUJI-OWN-FIX: the merged root was written with owners disabled, so every inode
+ * carries uid/gid 99 and launchd rejects each plist with error 122.  Re-own the
+ * launchd trees before init execs.  vnode_lookup cannot run in the mount context,
+ * so the walk runs in a kernel thread and the caller waits for it.
+ */
+static int
+houji_own_is_plist(const char *path)
+{
+	const char *suffix = ".plist";
+	size_t n = 0, m = 0, i;
+
+	while (path[n] != '\0') {
+		n++;
+	}
+	while (suffix[m] != '\0') {
+		m++;
+	}
+	if (n < m) {
+		return 0;
+	}
+	for (i = 0; i < m; i++) {
+		if (path[n - m + i] != suffix[i]) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+static volatile int houji_own_done;
+
+static void
+houji_own_one(const char *path, int isdir)
+{
+	vfs_context_t ctx = vfs_context_create(NULL);
+	vnode_t vp = NULLVP;
+
+	if (vnode_lookup(path, 0, &vp, ctx) == 0) {
+		struct vnode_attr va;
+		int dir = isdir;
+
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_type);
+		if (vnode_getattr(vp, &va, ctx) == 0 && va.va_type == VDIR) {
+			dir = 1;
+		}
+		VATTR_INIT(&va);
+		VATTR_WANTED(&va, va_uid);
+		VATTR_WANTED(&va, va_gid);
+		VATTR_SET(&va, va_uid, 0);
+		VATTR_SET(&va, va_gid, 0);
+		if (dir) {
+			VATTR_WANTED(&va, va_mode);
+			VATTR_SET(&va, va_mode, 0755);
+		} else if (houji_own_is_plist(path)) {
+			VATTR_WANTED(&va, va_mode);
+			VATTR_SET(&va, va_mode, 0644);
+		}
+		{
+			int serr = vnode_setattr(vp, &va, ctx);
+
+			if (serr != 0) {
+				printf("HOUJI-OWN-FIX: setattr %s err=%d\n", path, serr);
+			}
+		}
+		vnode_put(vp);
+	}
+	vfs_context_rele(ctx);
+}
+
+static void
+houji_own_tree(const char *dir, int depth)
+{
+	char buf[1024];
+	uint64_t off = 0;
+	vfs_context_t ctx;
+	vnode_t dvp = NULLVP;
+
+	houji_own_one(dir, 1);
+	if (depth >= 4) {
+		return;
+	}
+	ctx = vfs_context_create(NULL);
+	if (vnode_lookup(dir, 0, &dvp, ctx) != 0) {
+		vfs_context_rele(ctx);
+		return;
+	}
+	for (;;) {
+		int eofflag = 0;
+		int numdirent = 0;
+		uint64_t used;
+		uint64_t pos;
+		uio_t uio = uio_create(1, off, UIO_SYSSPACE, UIO_READ);
+
+		if (uio == NULL) {
+			break;
+		}
+		uio_addiov(uio, (uintptr_t)buf, sizeof(buf));
+		if (vnode_readdir64(dvp, uio, 0, &eofflag, &numdirent, ctx) != 0) {
+			uio_free(uio);
+			break;
+		}
+		used = sizeof(buf) - uio_resid(uio);
+		off = (uint64_t)uio_offset(uio);
+		uio_free(uio);
+		if (used == 0) {
+			break;
+		}
+		for (pos = 0; pos + sizeof(struct dirent) <= used; ) {
+			struct dirent *de = (struct dirent *)(void *)(buf + pos);
+			char path[1024];
+
+			if (de->d_reclen == 0) {
+				break;
+			}
+			if (de->d_namlen != 0 &&
+			    !(de->d_name[0] == '.' && (de->d_namlen == 1 ||
+			    (de->d_name[1] == '.' && de->d_namlen == 2)))) {
+				snprintf(path, sizeof(path), "%s/%s", dir, de->d_name);
+				houji_own_one(path, de->d_type == DT_DIR);
+				if (de->d_type == DT_DIR) {
+					houji_own_tree(path, depth + 1);
+				}
+			}
+			pos += de->d_reclen;
+		}
+		if (eofflag) {
+			break;
+		}
+	}
+	vnode_put(dvp);
+	vfs_context_rele(ctx);
+}
