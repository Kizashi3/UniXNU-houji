diff --git a/osfmk/kern/kalloc.c b/osfmk/kern/kalloc.c
--- a/osfmk/kern/kalloc.c
+++ b/osfmk/kern/kalloc.c
@@ -2616,8 +2616,25 @@
 		panic("kfree: addr %p, size %zd found in regular zone '%s%s'",
 		    data, size, zone_heap_name(z), z->z_name);
 	} else {
-		panic("kfree: addr %p, size %zd found in heap %s* instead of %s*",
-		    data, size, zone_heap_name(z), kheap_name);
+		uintptr_t *fp = (uintptr_t *)__builtin_frame_address(0);
+		void *ra1 = (void *)((uintptr_t *)fp[0])[1];
+		void *ra2 = (void *)((uintptr_t *)((uintptr_t *)fp[0])[0])[1];
+		static const char hx[] = "0123456789abcdef";
+		char dbuf[50];
+		int i;
+		for (i = 0; i < 16; i++) {
+			dbuf[i * 3] = hx[((uintptr_t)ra1 >> (60 - i * 4)) & 0xf];
+			dbuf[i * 3 + 1] = ' ';
+			dbuf[i * 3 + 2] = ' ';
+		}
+		dbuf[48] = 0;
+		printf("HOUJI-KFREE-RA1 %s\n", dbuf);
+		for (i = 0; i < 16; i++) {
+			dbuf[i * 3] = hx[((uintptr_t)ra2 >> (60 - i * 4)) & 0xf];
+		}
+		printf("HOUJI-KFREE-RA2 %s\n", dbuf);
+		panic("kfree: addr %p, size %zd found in heap %s* instead of %s* zone %s",
+		    data, size, zone_heap_name(z), kheap_name, z->z_name);
 	}
 }
 
