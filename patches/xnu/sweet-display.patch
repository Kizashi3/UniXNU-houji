+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef HOUJI_SURFACE_ACQUIRE_H
+#define HOUJI_SURFACE_ACQUIRE_H
+#include <stddef.h>
+#include <stdint.h>
+struct HoujiSurfaceCacheRange {uintptr_t begin,end;};
+static inline int houji_surface_cache_range(uintptr_t base,size_t allocation,uintptr_t row,size_t bytes,unsigned line,struct HoujiSurfaceCacheRange*out){
+ if(!out || !base || !allocation || !bytes || line<16 || line>2048 || (line&(line-1)) || allocation>UINTPTR_MAX-base || row<base || row>base+allocation || bytes>base+allocation-row || bytes>UINTPTR_MAX-row || row+bytes>UINTPTR_MAX-(line-1))return 0;
+ uintptr_t begin=row&~(uintptr_t)(line-1),end=(row+bytes+line-1)&~(uintptr_t)(line-1);
+ if(begin<base || end>base+allocation || end<=begin)return 0;
+ *out=(struct HoujiSurfaceCacheRange){begin,end};return 1;
+}
+#endif
diff --git a/iokit/Kernel/arm/SurfaceUseCount.h b/iokit/Kernel/arm/SurfaceUseCount.h
new file mode 100644
index 0000000..8b1e3e8
--- /dev/null
+++ b/iokit/Kernel/arm/SurfaceUseCount.h
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <stdint.h>
+enum class HoujiSurfaceUseResult { Updated, Underflow, Overflow };
+static inline HoujiSurfaceUseResult houjiSurfaceUseAdjust(volatile uint64_t *value,
+                                                         bool up,uint64_t &after) {
+    uint64_t old=__atomic_load_n(value,__ATOMIC_ACQUIRE);
+    for(;;){
+        if(up && old==UINT64_MAX){after=old;return HoujiSurfaceUseResult::Overflow;}
+        if(!up && old==0){after=0;return HoujiSurfaceUseResult::Underflow;}
+        uint64_t next=up?old+1:old-1;
+        if(__atomic_compare_exchange_n(value,&old,next,true,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE)){
+            after=next;return HoujiSurfaceUseResult::Updated;
+        }
+    }
+}
