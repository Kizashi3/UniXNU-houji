+static uint64_t sweet_fb_logged;        /* selectors already logged (< 64) */
+
+IOReturn
+IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t out[2] = { 0, 0 };
+	uint32_t outCount = 0;
+
+	switch (selector) {
+	case kSweetFBGetLayerDefaultSurface:
+		out[0] = sweet_surface_port_in_task(fFB->fSurface, fTask);
+		outCount = 1;
+		break;
+	case kSweetFBSwapBegin:
+		IOLockLock(fFB->fLock);
+		out[0] = ++fFB->fSwapID;
+		IOLockUnlock(fFB->fLock);
+		outCount = 1;
+		break;
+	case kSweetFBSwapEnd: {
+		uint8_t rec[SWEET_FB_SWAP_REC_SIZE];
+		if (args->structureInputDescriptor != NULL ||
+		    args->structureInputSize < SWEET_FB_SWAP_REC_SIZE) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		memcpy(rec, args->structureInput, sizeof(rec));
+		ret=fFB->swap(rec);
+		break;
+	}
+	case kSweetFBGetID:
+		out[0] = 1;
+		outCount = 1;
+		break;
+	case kSweetFBGetDisplaySize:
+		out[0] = HOUJI_LOGICAL_W;
+		out[1] = HOUJI_LOGICAL_H;
+		outCount = 2;
+		break;
+	case kSweetFBIsMainDisplay:
+		out[0] = 1;
+		outCount = 1;
+		break;
+	case kSweetFBGetDotPitch:
+		out[0] = SWEET_FB_DOT_PITCH;
+		outCount = 1;
+		break;
+	case kSweetFBNotifications:
+		if (args->scalarInputCount >= 3 && args->scalarInput[2] < SWEET_FB_NOTIFY_TYPES) {
+			uint32_t type = (uint32_t)args->scalarInput[2];
+			IOLockLock(fFB->fLock);
+			fFunc[type] = args->scalarInput[0];
+			fRefcon[type] = args->scalarInput[1];
+			IOLockUnlock(fFB->fLock);
+			char name[32];
+			proc_selfname(name, sizeof(name));
+			IOLog("SWEET FB: %s notifications type %u %s\n", name, type,
+			    args->scalarInput[0] ? "on" : "off");
+		}
+		break;
+	case 57: /* display identity query seen during open */
+		if (args->scalarOutput != NULL && args->scalarOutputCount > 0) {
+			out[0] = 1;
+			outCount = 1;
+		}
+		break;
+	case 79: /* display property blob: report unsupported so the caller keeps its defaults */
+		ret = kIOReturnUnsupported;
+		break;
+	case 74: /* one record so backboardd registers its display link */
+		if (args->scalarOutput != NULL && args->scalarOutputCount > 0) {
+			out[0] = 1;
+			outCount = 1;
+		}
+		if (args->structureOutput != NULL && args->structureOutputSize >= 64) {
+			bzero(args->structureOutput, args->structureOutputSize);
+		}
+		break;
+	case kSweetFBSwapWait:
+		if(args->scalarInputCount!=3){ret=kIOReturnBadArgument;break;}
+		__atomic_store_n(&houji_fb_last_wait_id,args->scalarInput[0],__ATOMIC_RELAXED);
+		__atomic_store_n(&houji_fb_last_wait_mode,args->scalarInput[1],__ATOMIC_RELAXED);
+		__atomic_store_n(&houji_fb_last_wait_ns,args->scalarInput[2],__ATOMIC_RELAXED);
+		ret=fFB->waitSwap((uint32_t)args->scalarInput[0],args->scalarInput[2]);
+		break;
+	default:
+		break;
+	}
+
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = i < outCount ? out[i] : 0;
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	if (selector >= 64 || !(sweet_fb_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			sweet_fb_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		uint64_t do0 = 0, do1 = 0;
+		uint32_t ds0 = 0, ds1 = 0;
+		if (args->scalarOutput != NULL && args->scalarOutputCount > 0) {
+			do0 = args->scalarOutput[0];
+		}
+		if (args->scalarOutput != NULL && args->scalarOutputCount > 1) {
+			do1 = args->scalarOutput[1];
+		}
+		if (args->structureOutput != NULL && args->structureOutputSize >= 4) {
+			ds0 = *(const uint32_t *)args->structureOutput;
+		}
+		if (args->structureOutput != NULL && args->structureOutputSize >= 8) {
+			ds1 = *(const uint32_t *)((const uint8_t *)args->structureOutput + 4);
+		}
+		uint64_t di0 = 0, di1 = 0, di2 = 0;
+		if (args->scalarInput != NULL && args->scalarInputCount > 0) {
+			di0 = args->scalarInput[0];
+		}
+		if (args->scalarInput != NULL && args->scalarInputCount > 1) {
+			di1 = args->scalarInput[1];
+		}
+		if (args->scalarInput != NULL && args->scalarInputCount > 2) {
+			di2 = args->scalarInput[2];
+		}
+		IOLog("SWEET FB: %s sel %u in %u/%u out %u/%u -> 0x%x i0=%#llx i1=%#llx i2=%#llx o0=%#llx o1=%#llx s0=%#x s1=%#x\n",
+		    name, selector, args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize, ret,
+		    di0, di1, di2, do0, do1, ds0, ds1);
+	}
+	return ret;
+}
+#endif /* SWEET */
