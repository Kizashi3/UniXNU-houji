+/*
+ * HOUJI-SVCTRACE-v1: log the system calls made from user threads.
+ *
+ * The ramdisk root ships no /dev nodes, so nothing a userland process writes can be
+ * observed and launchd blocking inside the kernel looks exactly like dyld looping in
+ * userland. The svctrace=N boot-arg prints the first N user-thread SVC entries with
+ * their argument registers; the final entry without a matching return line is the
+ * call the boot is stuck in.
+ */
+
+extern boolean_t PE_parse_boot_argn(const char *arg_string, void *arg_ptr, int arg_len);
+
+static uint32_t unixnu_svctrace_limit;
+static uint32_t unixnu_svctrace_seen;
+static int unixnu_svctrace_parsed;
+
+static boolean_t
+unixnu_svctrace_begin(arm_saved_state_t *state, thread_t thread, int trap_no)
+{
+	arm_saved_state64_t *state64;
+
+	if (unixnu_svctrace_parsed == 0) {
+		unixnu_svctrace_parsed = 1;
+		PE_parse_boot_argn("svctrace", &unixnu_svctrace_limit, sizeof(unixnu_svctrace_limit));
+	}
+	if ((unixnu_svctrace_limit == 0) || !is_saved_state64(state) ||
+	    (get_threadtask_early(thread) == kernel_task)) {
+		return FALSE;
+	}
+	if ((trap_no == MACH_ARM_TRAP_ABSTIME) || (trap_no == MACH_ARM_TRAP_CONTTIME) ||
+	    (trap_no == (int)PLATFORM_SYSCALL_TRAP_NO)) {
+		return FALSE;
+	}
+	if (unixnu_svctrace_seen++ >= unixnu_svctrace_limit) {
+		return FALSE;
+	}
+	state64 = saved_state64(state);
+	kprintf("SVCTRACE: -> %u trap=%d pc=%llx x0=%llx x1=%llx x2=%llx x3=%llx x4=%llx x5=%llx x16=%llx x17=%llx\n",
+	    (unsigned) unixnu_svctrace_seen, trap_no,
+	    (unsigned long long) get_saved_state_pc(state),
+	    (unsigned long long) state64->x[0], (unsigned long long) state64->x[1],
+	    (unsigned long long) state64->x[2], (unsigned long long) state64->x[3],
+	    (unsigned long long) state64->x[4], (unsigned long long) state64->x[5],
+	    (unsigned long long) state64->x[16], (unsigned long long) state64->x[17]);
+	return TRUE;
+}
+
+static void
+unixnu_svctrace_end(arm_saved_state_t *state, int trap_no)
+{
+	arm_saved_state64_t *state64 = saved_state64(state);
+
+	kprintf("SVCTRACE: <- %u trap=%d x0=%llx\n",
+	    (unsigned) unixnu_svctrace_seen, trap_no, (unsigned long long) state64->x[0]);
+}
+
 extern void syscall_trace(struct arm_saved_state * regs);
 
 static void
