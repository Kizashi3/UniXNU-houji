 	bsd_init_kprintf("done\n");
 }
 
+static void
+houji_install_mobileactivation_plist(void)
+{
+	static const char plist[] =
+	    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" "
+	    "\"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	    "<plist version=\"1.0\"><dict>"
+	    "<key>Label</key><string>com.apple.mobileactivationd</string>"
+	    "<key>ProgramArguments</key><array>"
+	    "<string>/usr/libexec/mobileactivationd</string></array>"
+	    "<key>MachServices</key><dict>"
+	    "<key>com.apple.mobileactivationd</key><true/>"
+	    "<key>com.apple.mobileactivationd.lockdown</key><true/>"
+	    "</dict>"
+	    "<key>POSIXSpawnType</key><string>Adaptive</string>"
+	    "<key>UserName</key><string>mobile</string>"
+	    "<key>EnableTransactions</key><true/>"
+	    "<key>EnablePressuredExit</key><true/>"
+	    "</dict></plist>\n";
+	const char *path = "/System/Library/LaunchDaemons/com.apple.mobileactivationd.plist";
+	vfs_context_t ctx = vfs_context_create(NULL);
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	uio_t uio;
+	int error;
+
+	if (vnode_lookup(path, 0, &vp, ctx) == 0) {
+		vnode_put(vp);
+		vfs_context_rele(ctx);
+		printf("HOUJI-ACTIVATION: plist already present\n");
+		return;
+	}
+	error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, 0644, 0, &vp, ctx);
+	if (error != 0) {
+		vfs_context_rele(ctx);
+		printf("HOUJI-ACTIVATION: open err=%d\n", error);
+		return;
+	}
+	uio = uio_create(1, 0, UIO_SYSSPACE, UIO_WRITE);
+	if (uio == NULL) {
+		vnode_close(vp, FWRITE, ctx);
+		vfs_context_rele(ctx);
+		printf("HOUJI-ACTIVATION: uio alloc failed\n");
+		return;
+	}
+	uio_addiov(uio, (uintptr_t)plist, sizeof(plist) - 1);
+	error = VNOP_WRITE(vp, uio, 0, ctx);
+	uio_free(uio);
+	if (error == 0) {
+		error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_uid);
+	VATTR_WANTED(&va, va_gid);
+	VATTR_WANTED(&va, va_mode);
+	VATTR_SET(&va, va_uid, 0);
+	VATTR_SET(&va, va_gid, 0);
+	VATTR_SET(&va, va_mode, 0644);
+	(void)vnode_setattr(vp, &va, ctx);
+	vnode_close(vp, FWRITE, ctx);
+	vfs_context_rele(ctx);
+	printf("HOUJI-ACTIVATION: bsdinit plist install err=%d len=%u\n",
+	    error, (unsigned)(sizeof(plist) - 1));
+}
+
 void
 bsdinit_task(void)
 {
@@ -1096,6 +1165,7 @@ bsdinit_task(void)
 
 	bsd_init_kprintf("bsd_do_post - done");
 
+	houji_install_mobileactivation_plist();
 	load_init_program(p);
 	lock_trace = 1;
 }
