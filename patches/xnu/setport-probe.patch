+/*
+ * Legacy array-form kernel entry, kept for iOS 16 libsystem_kernel clients.
+ */
+kern_return_t
+mach_ports_register(
+	task_t                  task,
+	mach_port_array_t       init_port_set,
+	mach_msg_type_number_t  init_port_setCnt)
+{
+	ipc_port_t ports[TASK_PORT_REGISTER_MAX] = { IP_NULL, IP_NULL, IP_NULL };
+	unsigned int i;
+
+	if (task == TASK_NULL) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	if (init_port_setCnt > TASK_PORT_REGISTER_MAX) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	for (i = 0; i < init_port_setCnt; i++) {
+		ports[i] = init_port_set[i].port;
+		if (IP_VALID(ports[i]) && ports[i]->ip_immovable_send) {
+			return KERN_INVALID_RIGHT;
+		}
+	}
+
+	itk_lock(task);
+	if (!task->ipc_active) {
+		itk_unlock(task);
+		return KERN_INVALID_ARGUMENT;
+	}
+	for (i = 0; i < TASK_PORT_REGISTER_MAX; i++) {
+		ipc_port_t old = task->itk_registered[i];
+		task->itk_registered[i] = ports[i];
+		ports[i] = old;
+	}
+	itk_unlock(task);
+
+	printf("HOUJI-SETPORT: legacy register count=%u ok\n", init_port_setCnt);
+
+	for (i = 0; i < TASK_PORT_REGISTER_MAX; i++) {
+		ipc_port_release_send(ports[i]);
+	}
+	return KERN_SUCCESS;
+}
+
+kern_return_t
+mach_ports_lookup(
+	task_t                  task,
+	mach_port_array_t      *init_port_set,
+	mach_msg_type_number_t *init_port_setCnt)
+{
+	mach_port_ool_t *ports;
+	unsigned int i;
+
+	if (task == TASK_NULL) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	ports = kalloc_data(TASK_PORT_REGISTER_MAX * sizeof(*ports), Z_WAITOK);
+	if (ports == NULL) {
+		return KERN_RESOURCE_SHORTAGE;
+	}
+	itk_lock(task);
+	if (!task->ipc_active) {
+		itk_unlock(task);
+		kfree_data(ports, TASK_PORT_REGISTER_MAX * sizeof(*ports));
+		return KERN_INVALID_ARGUMENT;
+	}
+	for (i = 0; i < TASK_PORT_REGISTER_MAX; i++) {
+		ports[i].port = ipc_port_copy_send_any(task->itk_registered[i]);
+	}
+	itk_unlock(task);
+
+	*init_port_set = ports;
+	*init_port_setCnt = TASK_PORT_REGISTER_MAX;
+	return KERN_SUCCESS;
+}
