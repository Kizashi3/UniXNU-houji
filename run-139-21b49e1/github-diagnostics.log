[payload]
volume = "GIULIAESP"
size_mib = 192
loader = "firmware"
title = "Xiaomi 14 houji XNU first entry (no system volume)"
# The first-entry handoff window, not total installed device RAM.
dram_size = "0x10000000"
panic_screen = false
timeout = 0
kernel_args = ["-v", "serial=3", "debug=0x14e", "-enable_kprintf_spam=1", "armcpu-diagnostics=1", "houji-ufs-probe=2"]

[payload.adt]
tool = "scripts/make-houji-adt.py"
owned_memory_size = "0x10000000"
cpu_regs = "0"
psci_method = "smc"

[firmware]
config = "houji"
