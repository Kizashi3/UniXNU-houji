# Xiaomi 14 (houji): XNU first-entry build; no system volume or storage driver yet.
[board]
name = "houji"
soc = "SM8650"
description = "Xiaomi 14 houji SM8650"
kit = "houji"

# Read-only live GPT of the connected Xiaomi 14 unit, CRC-checked on 2026-10-21.
# Specific to the connected 256 GB unit; does not authorize flashing userdata.
[userdata]
first_lba = 3920350
last_lba = 61321210
lba_bytes = 4096
windows = [
  { name = "OS", component = "OS" },
  { name = "SystemOS", component = "Cryptex1,SystemOS" },
]

[ipsw]
url = "https://updates.cdn-apple.com/2025FallFCS/fullrestores/122-77006/1158E502-D76D-4226-AA06-ED5E30CD1111/iPhone10,3,iPhone10,6_16.7.16_20H392_Restore.ipsw"
product = "iPhone10,3"
version = "16.7.16"
build = "20H392"
device_class = "d22ap"
chip_id = 0x8015
board_id = 6
fetch = ["KernelCache", "DeviceTree", "StaticTrustCache", "Cryptex1,SystemTrustCache"]   # the small components

[ipsw.sha256]
# Raw KernelCache member pin (the local input is the same IM4P member).
"kernelcache.release.iphone10b" = "2d6a13d040aaf87cec09bb6906d43e9bd8cea951e43d1aa1cd62707dfdc5aaec"

[kernel]
defconfig = "houji_defconfig"
patch_series = ["patches/xnu-iorpc-message-from-mach.patch"]
archives = [
  "build-corecrypto-14.py",
  "build-corecrypto-14.py --namespace",
  "build-arm-driver.py ArmDTPlatform",
  "build-arm-driver.py ArmCpu",
  "build-libpthread-kernel.py",
  "build-arm-driver.py NativeAES",
  "build-native-aes-bindings.py",
]

[kernel.prelink]
kernelcache_sha256 = "2ec297bac95bcba01046fd0148e97e7e5885c05a6c18827f39f534ba375c1221"
tool = "kits/NativePrelink/emit_prelink.py"
kernel = "build/xnu/ios-obj/DEVELOPMENT_ARM64_BCM2837/mach.development.bcm2837.unstripped.noctf"
# Set after macOS compression_tool decodes the iOS 16.7.16 KernelCache IM4P.
slide = "-0x1000000"
# 20H392 AMFI policy initializer; see docs/prelink-20H392-validation.md.
early_security_init = "com.apple.driver.AppleMobileFileIntegrity=0xfffffff005703c54"
roots = [
  "com.apple.AppleFSCompression.AppleFSCompressionTypeZlib",
  "com.apple.driver.AppleARMPlatform",
  "com.apple.driver.AppleARMWatchdogTimer",
  "com.apple.driver.AppleAudioClockLibs",
  "com.apple.driver.AppleEffaceableStorage",
  "com.apple.driver.AppleIISController",
  "com.apple.driver.AppleM2ScalerCSCDriver",
  "com.apple.driver.AppleMobileFileIntegrity",
  "com.apple.driver.ApplePMGR",
  "com.apple.driver.IODARTFamily",
  "com.apple.filesystems.apfs",
  "com.apple.iokit.CoreAnalyticsFamily",
  "com.apple.iokit.IOAVFamily",
  "com.apple.iokit.IOAudio2Family",
  "com.apple.iokit.IOCECFamily",
